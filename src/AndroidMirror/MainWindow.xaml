<ui:FluentWindow x:Class="TouchMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:TouchMirror.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:TouchMirror"
        mc:Ignorable="d"
        Title="TouchMirror" Icon="assets/mascot.png"
        MinWidth="1060" MinHeight="560" Width="1280" Height="800"
        FontFamily="Segoe UI Variable Text"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding Topmost}"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        PreviewTextInput="OnPreviewTextInput">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="ToolBtn" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
        </Style>

        <Style x:Key="QCard" TargetType="ui:Card"
               BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="15,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="Auto" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition x:Name="UpdateRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusBarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarElement" Grid.Row="0" Title="TouchMirror" ShowMaximize="True" ShowMinimize="True" />

                <!-- ══ Toolbar ══ -->
        <Border Grid.Row="1" x:Name="Toolbar"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="14,5">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="HelpButton" Style="{StaticResource ToolBtn}" Click="OnHelpClick"
                               Height="32" Width="Auto" Padding="10,0" Margin="0,0,10,0"
                               ToolTip="Guides Dofus Touch — navigateur intégré">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BookOpenGlobe24" FontSize="15"
                                           Foreground="{DynamicResource DofusAccentBrush}"
                                           Margin="0,0,7,0" />
                            <TextBlock Text="Guides" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DofusAccentBrush}" />
                        </StackPanel>
                    </ui:Button>
                    <ItemsControl ItemsSource="{Binding Workspaces}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="28" Padding="9,0" Margin="0,0,5,0" CornerRadius="7"
                                        Background="{DynamicResource AppSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        MouseLeftButtonUp="OnWorkspaceChipClick"
                                        ToolTip="Basculer vers cet espace · clic droit : gérer · Ctrl+Maj+N">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4EC98E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource NotBoolToVis}}">
                                            <ui:SymbolIcon Symbol="Apps24" FontSize="12" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DeviceCount, StringFormat='{}· {0}'}"
                                                       FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Name, Mode=OneWay}" MinWidth="50" Padding="0"
                                                 Background="Transparent" BorderThickness="0" FontSize="11.5"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                 KeyDown="OnWorkspaceNameKeyDown"
                                                 LostFocus="OnWorkspaceNameLostFocus"
                                                 IsVisibleChanged="OnWorkspaceNameVisible" />
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Renommer" Click="OnWorkspaceEditClick" />
                                            <MenuItem Header="Dupliquer" Click="OnWorkspaceDuplicateClick" />
                                            <Separator />
                                            <MenuItem Header="Fermer l'espace" Click="OnWorkspaceExitClick"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="Supprimer" Click="OnWorkspaceDeleteClick"
                                                      Foreground="#E05B4C" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Style="{StaticResource ToolBtn}" Margin="0,0,8,0"
                               Command="{Binding NewWorkspaceCommand}"
                               ToolTip="Nouvel espace de travail — mémorise appareils, ordre, miroir actif et réglages par appareil">
                        <ui:SymbolIcon Symbol="Add24" FontSize="13" />
                    </ui:Button>
                    <Border Width="1" Height="16" Margin="0,0,10,0"
                            Background="{DynamicResource AppBorderBrush}" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              Width="225" MaxWidth="225" MinWidth="120"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ShortName}" />
                                    <TextBlock Text="{Binding SelectorHint}" FontSize="10.5"
                                               Margin="6,1,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Style="{StaticResource ToolBtn}"
                               Command="{Binding RefreshDevicesCommand}"
                               ToolTip="Rafraîchir les appareils">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                    </ui:Button>
                    <ui:Button Appearance="Primary"
                               Command="{Binding ConnectCommand}"
                               IsEnabled="{Binding CanConnect}"
                               Margin="12,0,0,0" Padding="16,0" Height="32"
                               FontWeight="SemiBold"
                               Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource NotBoolToVis}}">
                                <ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Connecter" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Connexion…" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <ui:Button Command="{Binding ConnectCommand}"
                                   IsEnabled="{Binding CanConnect}"
                                   Padding="12,0" Height="32"
                                   FontWeight="SemiBold"
                                   ToolTip="Ajouter un autre téléphone à la grille (multicompte)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="15" Margin="0,0,6,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Ajouter" Foreground="{DynamicResource DofusAccentBrush}" />
                            </StackPanel>
                        </ui:Button>
                        <Ellipse Width="7" Height="7" Fill="#4EC98E" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveMirrorName}" FontSize="12" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="9" Padding="2"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource ToolBtn}" Command="{Binding SendBackCommand}" ToolTip="Retour">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ToolBtn}" Command="{Binding SendHomeCommand}" ToolTip="Accueil Android">
                                    <ui:SymbolIcon Symbol="Home24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ToolBtn}" Command="{Binding SendRecentsCommand}" ToolTip="Récents">
                                    <ui:SymbolIcon Symbol="SquareMultiple24" FontSize="15" />
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="9" Padding="2" Margin="8,0,0,0"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource ToolBtn}" Width="Auto" Padding="9,0"
                                           Click="OnMoreClick" ToolTip="Captures et enregistrement">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Camera24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Capturer" />
                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Capture PNG (Images\TouchMirror)"
                                                      Command="{Binding ScreenshotCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Camera24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Enregistrer en vidéo (Vidéos\TouchMirror)"
                                                      Command="{Binding ToggleRecordingCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Record24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Ouvrir le dossier des captures" Click="OnOpenCapturesClick">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                                <ui:Button Style="{StaticResource ToolBtn}" Width="Auto" Padding="9,0"
                                           Click="OnMoreClick" ToolTip="Affichage et disposition">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Affichage" />
                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Plein écran (F11)" Click="OnFullscreenClick">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Tourner l'image affichée" Click="OnRotateDisplayClick">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Pivoter l'écran du téléphone"
                                                      Command="{Binding RotateDeviceCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="PhoneScreenTime24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Fenêtre au-dessus des autres" IsCheckable="True"
                                                      IsChecked="{Binding Topmost}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Pin24" FontSize="14" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="9" Padding="2" Margin="8,0,0,0"
                                Background="#22E05B4C" BorderBrush="#55E05B4C" BorderThickness="1"
                                Visibility="{Binding RecordingVisibility}">
                            <ui:Button Style="{StaticResource ToolBtn}" Width="Auto" Padding="8,0"
                                       Command="{Binding ToggleRecordingCommand}"
                                       ToolTip="Arrêter l'enregistrement">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#E05B4C"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding RecordingElapsed}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#E05B4C" />
                                </StackPanel>
                            </ui:Button>
                        </Border>

                        <Border Width="1" Height="18" Margin="10,0"
                                Background="{DynamicResource AppBorderBrush}" />
                    </StackPanel>

                    <ui:Button Style="{StaticResource ToolBtn}" Click="OnSettingsClick"
                               ToolTip="Réglages" Margin="4,0,0,0">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolBtn}" Click="OnMoreClick" ToolTip="Plus" Margin="4,0,0,0">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="15" />
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Activer le WiFi (mirroring sans câble)"
                                          Command="{Binding EnableWifiCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Wifi124" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Éteindre/allumer l'écran du téléphone"
                                          Command="{Binding SendPowerCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Phone24" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Mode Dofus (preset optimal)"
                                          Command="{Binding ApplyDofusPresetCommand}"
                                          ToolTip="1080p · 60 fps · 24 Mbps H.264 · audio · écran atténué — une seule reconnexion"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource DofusAccentBrush}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Flash24" FontSize="14"
                                                                  Foreground="{DynamicResource DofusAccentBrush}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Mode capture (cache le badge fps — pour OBS/stream)"
                                          IsCheckable="True" Click="OnCaptureModeClick" />
                                <Separator />
                                <MenuItem Header="Déconnecter ce téléphone"
                                          Command="{Binding DisconnectCommand}"
                                          Foreground="#E05B4C">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="14"
                                                                  Foreground="#E05B4C" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

<!-- ══ Bandeau mise à jour ══ -->
        <Border Grid.Row="2" Padding="16,8"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Visibility="{Binding UpdateBannerVisibility}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14"
                               Foreground="{DynamicResource DofusAccentBrush}"
                               VerticalAlignment="Center" />
                <TextBlock FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center">
                    <Run Text="Nouvelle version disponible — v" />
                    <Run Text="{Binding UpdateVersion}" FontWeight="SemiBold" />
                </TextBlock>
                <ui:Button Appearance="Primary" Height="26" Padding="12,0" Margin="10,0,0,0"
                           FontSize="12" FontWeight="SemiBold"
                           Command="{Binding OpenUpdateCommand}">
                    Télécharger
                </ui:Button>
                <ui:Button Style="{StaticResource ToolBtn}" Command="{Binding DismissUpdateCommand}"
                           ToolTip="Ignorer">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- ══ Contenu ══ -->
        <Grid Grid.Row="3" Background="#0A0B0F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="VideoFrame" Grid.Column="1"
                    Margin="18" CornerRadius="14"
                    Background="Black"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Miroir actif -->
                    <Border CornerRadius="10" Margin="4" Background="Black"
                            BorderBrush="{Binding ActiveMirror.AccentHex, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#4EC98E" BlurRadius="18"
                                              ShadowDepth="0" Opacity="0.16" />
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter Content="{Binding ActiveMirror.View}" />

                            <Border VerticalAlignment="Top" Padding="10,5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#D0101216" Offset="0" />
                                        <GradientStop Color="#00101216" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Phone24" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"
                                                       Foreground="{DynamicResource DofusAccentBrush}" />
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding ActiveMirror.AccentHex, Converter={StaticResource HexToBrush}}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Visibility="{Binding ActiveMirror.IsConnected, Converter={StaticResource BoolToVis}}" />
                                        <TextBox Text="{Binding ActiveMirror.DeviceName, Mode=OneWay}"
                                                 FontSize="12" Padding="0" MinWidth="40"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 ToolTip="Renommer — Entrée pour valider, Échap pour annuler"
                                                 KeyDown="OnMirrorNameKeyDown"
                                                 LostFocus="OnMirrorNameLostFocus" />
                                        <Ellipse Width="6" Height="6" Fill="#E05B4C" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding ActiveMirror.IsRecording, Converter={StaticResource BoolToVis}}" />
                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="5"
                                                Background="#2EFFFFFF"
                                                Visibility="{Binding HasInactiveMirrors, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="Ctrl" /><Run Text="+" /><Run Text="{Binding ActiveMirror.Slot, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                               Width="26" Height="22" Padding="0"
                                               Command="{Binding RemoveMirrorCommand}"
                                               CommandParameter="{Binding ActiveMirror}"
                                               ToolTip="Déconnecter cet appareil">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Miniatures des autres appareils + tuiles absentes de l'espace -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasStripContent, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                        <ItemsControl ItemsSource="{Binding InactiveMirrors}" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="172" Height="112" Margin="6,4"
                                            CornerRadius="8" Background="Black"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" ClipToBounds="True"
                                            ToolTip="Cliquer pour rendre actif">
                                        <Grid>
                                            <ContentPresenter Content="{Binding View}" />
                                            <Border VerticalAlignment="Top" Padding="7,3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#D0101216" Offset="0" />
                                                        <GradientStop Color="#00101216" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                                        <TextBox Text="{Binding DeviceName, Mode=OneWay}"
                                                                 FontSize="11" Padding="0" MinWidth="30"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                 ToolTip="Renommer — Entrée pour valider, Échap pour annuler"
                                                                 KeyDown="OnMirrorNameKeyDown"
                                                                 LostFocus="OnMirrorNameLostFocus" />
                                                        <Ellipse Width="6" Height="6" Fill="#E05B4C" Margin="7,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                                               Width="20" Height="16" Padding="0"
                                                               Command="{Binding DataContext.RemoveMirrorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Déconnecter cet appareil">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    Margin="6" CornerRadius="6"
                                                    Background="#C0101216">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Appearance="Transparent" Width="20" Height="16" Padding="0"
                                                               Command="{Binding DataContext.MoveMirrorLeftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Monter dans la liste">
                                                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="9" />
                                                    </ui:Button>
                                                    <ui:Button Appearance="Transparent" Width="20" Height="16" Padding="0"
                                                               Command="{Binding DataContext.MoveMirrorRightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Descendre dans la liste">
                                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="9" />
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                    Margin="6" Padding="7,2" CornerRadius="6"
                                                    Background="#C0101216">
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Ctrl" /><Run Text="+" /><Run Text="{Binding Slot, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MissingDevices}" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="172" Height="112" Margin="6,4" CornerRadius="8"
                                            Background="#0DFFFFFF" BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" Opacity="0.75"
                                            MouseLeftButtonUp="OnMissingClick"
                                            ToolTip="Appareil absent de l'espace — cliquer pour retenter la connexion">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Phone24" FontSize="20"
                                                               Foreground="#5A5E66"
                                                               HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                            HorizontalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                             Margin="0,0,6,0"
                                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="absent" FontSize="9.5" Margin="0,1,0,0"
                                                           Foreground="#5A5E66"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Appearance="Transparent" Width="22" Height="18"
                                                       Padding="0" Margin="4"
                                                       Command="{Binding DataContext.RemoveMissingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Retirer de l'espace">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="FullscreenBar"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="4" CornerRadius="12"
                            Background="#E614161C"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding SendBackCommand}" ToolTip="Retour" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14.5" />
                            </ui:Button>
                            <ui:Button Command="{Binding SendHomeCommand}" ToolTip="Accueil" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="Home24" FontSize="14.5" />
                            </ui:Button>
                            <ui:Button Command="{Binding SendRecentsCommand}" ToolTip="Récents" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="SquareMultiple24" FontSize="14.5" />
                            </ui:Button>
                            <ui:Button Click="OnFullscreenClick" ToolTip="Quitter le plein écran (Échap ou F11)" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="FullScreenMinimize24" FontSize="16" />
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- ══ Hub appareils (déconnecté) ══ -->
                    <Grid x:Name="DisconnectedOverlay" Background="#F40A0B0F"
                          Visibility="{Binding Mirrors.Count, Converter={StaticResource EmptyToVis}}">
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.4" />
                                        <DoubleAnimation Storyboard.TargetName="HubBlock"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="14" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Image Source="assets/mascot.png" Width="620" Opacity="0.035"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HubBlock" MaxWidth="720" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="20,14">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0" />
                            </StackPanel.RenderTransform>

                            <Grid Margin="2,0,2,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Appareils" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <Run Text="{Binding DetectedDeviceCount, Mode=OneWay}" /><Run Text=" détecté(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding AdbStatus}" FontSize="12" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>

                            <ui:Card Padding="0" BorderThickness="1"
                                     BorderBrush="#12FFFFFF"
                                     Background="{DynamicResource AppSurfaceBrush}">
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,15"
                                                    BorderThickness="0,1,0,0"
                                                    BorderBrush="#0AFFFFFF">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Couleur de l'appareil">
                                                            <MenuItem.Icon>
                                                                <ui:SymbolIcon Symbol="Color24" FontSize="14" />
                                                            </MenuItem.Icon>
                                                            <MenuItem Header="Par défaut" Tag="" Click="OnDeviceColorClick" />
                                                            <MenuItem Header="Vert" Tag="#4EC98E" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#4EC98E" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Bleu" Tag="#5B9BD5" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#5B9BD5" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Violet" Tag="#9B7BD4" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#9B7BD4" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Orange" Tag="#E8A33D" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#E8A33D" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Rose" Tag="#E06B9B" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#E06B9B" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Rouge" Tag="#E05B4C" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#E05B4C" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Cyan" Tag="#4EC9C0" Click="OnDeviceColorClick">
                                                                <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="3" Background="#4EC9C0" /></MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Oublier cet appareil" Click="OnDeviceForgetClick">
                                                            <MenuItem.Icon>
                                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="44" Height="44" CornerRadius="11"
                                                                Background="#1A4EC98E" Margin="0,0,14,0">
                                                            <ui:SymbolIcon Symbol="Phone24" FontSize="18"
                                                                           Foreground="{DynamicResource DofusAccentBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                                <TextBox Text="{Binding ShortName, Mode=OneWay}"
                                                                         FontSize="14" FontWeight="SemiBold" Padding="0"
                                                                         Background="Transparent" BorderThickness="0"
                                                                         ToolTip="Renommer ce téléphone — Entrée pour valider, Échap pour annuler"
                                                                         KeyDown="OnDeviceNameKeyDown"
                                                                         LostFocus="OnDeviceNameLostFocus" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding TransportText}" FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBox Text="{Binding Serial}" IsReadOnly="True"
                                                                         FontSize="10.5" Margin="8,0,0,0" Padding="0"
                                                                         Background="Transparent" BorderThickness="0"
                                                                         VerticalAlignment="Center"
                                                                         Visibility="{Binding ShowSerial, Converter={StaticResource BoolToVis}}"
                                                                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="Accepte la fenêtre d'autorisation sur le téléphone"
                                                                       FontSize="10.5" Margin="0,3,0,0" Foreground="#E8A33D"
                                                                       Visibility="{Binding NeedsAuthorization, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#5A5E66" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                                <Setter Property="Fill" Value="#4EC98E" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding NeedsAuthorization}" Value="True">
                                                                                <Setter Property="Fill" Value="#E8A33D" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding StateText}" FontSize="11.5">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                                <Setter Property="Foreground" Value="#4EC98E" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding NeedsAuthorization}" Value="True">
                                                                                <Setter Property="Foreground" Value="#E8A33D" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                                                                <ui:SymbolIcon Symbol="Battery924" FontSize="12"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding BatteryText}" FontSize="11.5" Margin="4,0,0,0"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ui:Button Appearance="Transparent" Padding="4" Margin="12,0,0,0"
                                                                       VerticalAlignment="Center" ToolTip="Oublier cet appareil"
                                                                       Command="{Binding DataContext.ForgetDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       CommandParameter="{Binding}"
                                                                       Visibility="{Binding IsRememberedOnly, Converter={StaticResource BoolToVis}}">
                                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Appearance="Primary" Height="36" Padding="16,0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Command="{Binding DataContext.ConnectToDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               IsEnabled="{Binding IsReady}"
                                                               Visibility="{Binding IsRememberedOnly, Converter={StaticResource NotBoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Play24" FontSize="12" Margin="0,0,7,0" />
                                                            <TextBlock Text="Connecter" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:Card>

                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <ui:Button Margin="0,0,6,0" Padding="15,14"
                                           HorizontalContentAlignment="Left"
                                           Click="OnHelpClick" ToolTip="Ouvrir le navigateur de guides intégré">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="9" Background="#1A4EC98E"
                                                VerticalAlignment="Center" Margin="0,0,11,0">
                                            <ui:SymbolIcon Symbol="BookOpenGlobe24" FontSize="14"
                                                           Foreground="{DynamicResource DofusAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Guides Dofus" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="Sites intégrés" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Margin="4,0" Padding="15,14"
                                           HorizontalContentAlignment="Left"
                                           Command="{Binding EnableWifiCommand}"
                                           ToolTip="Activer le mirroring sans câble sur l'appareil sélectionné">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="9" Background="#1A4EC98E"
                                                VerticalAlignment="Center" Margin="0,0,11,0">
                                            <ui:SymbolIcon Symbol="Wifi124" FontSize="14"
                                                           Foreground="{DynamicResource DofusAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WiFi" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="Sans câble" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Margin="4,0" Padding="15,14"
                                           HorizontalContentAlignment="Left"
                                           Command="{Binding ToggleScreenDimCommand}"
                                           ToolTip="Luminosité du téléphone au minimum pendant le mirroring">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="9" Background="#1A4EC98E"
                                                VerticalAlignment="Center" Margin="0,0,11,0">
                                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="14"
                                                           Foreground="{DynamicResource DofusAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Écran atténué" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TurnScreenOffText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Margin="6,0,0,0" Padding="15,14"
                                           HorizontalContentAlignment="Left"
                                           Click="OnSettingsClick" ToolTip="Ouvrir les réglages">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="9" Background="#1A4EC98E"
                                                VerticalAlignment="Center" Margin="0,0,11,0">
                                            <ui:SymbolIcon Symbol="Settings24" FontSize="14"
                                                           Foreground="{DynamicResource DofusAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Réglages" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="Vidéo, audio, session" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Button>
                            </UniformGrid>

                            <Border Margin="0,12,0,0" Padding="18,13" CornerRadius="12"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="#12FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DÉMARRAGE" FontSize="11" FontWeight="Bold"
                                               Margin="0,0,14,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#264EC98E">
                                        <TextBlock Text="1" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource DofusAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Branche en USB" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:SymbolIcon Symbol="ArrowRight16" FontSize="11" Margin="10,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#264EC98E">
                                        <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource DofusAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Débogage USB" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:SymbolIcon Symbol="ArrowRight16" FontSize="11" Margin="10,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#264EC98E">
                                        <TextBlock Text="3" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource DofusAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Connecter" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ Panneau réglages ══ -->
            <Border x:Name="SettingsPanel" Grid.Column="2"
                    Width="320"
                    Margin="0,14,14,14" CornerRadius="14"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    Visibility="{Binding SettingsVisibility}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide" X="0" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSettings}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                             From="40" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,13,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="13" Margin="0,0,8,0"
                                           Foreground="{DynamicResource DofusAccentBrush}" />
                            <TextBlock Text="Réglages" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                   Width="28" Height="26" Padding="0" Click="OnSettingsClick">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                        </ui:Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,10,14,14">
                            <Grid Margin="4,4,0,7">
                                <TextBlock Text="VIDÉO" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding ActiveSettingsScope}" FontSize="10.5"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <Border CornerRadius="10" Padding="12,0"
                                    Background="#07FFFFFF"
                                    BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <Grid MinHeight="42">
                                        <TextBlock Text="Résolution" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox Width="175" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ItemsSource="{Binding MaxSizeOptions}"
                                                  SelectedValue="{Binding MaxSize}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="42">
                                        <TextBlock Text="Codec" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox Width="175" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ItemsSource="{Binding CodecOptions}"
                                                  SelectedValue="{Binding VideoCodec}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="42">
                                        <TextBlock Text="Framerate" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox Width="175" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ItemsSource="{Binding FpsOptions}"
                                                  SelectedValue="{Binding MaxFps}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="42">
                                        <TextBlock Text="Débit vidéo" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox Width="175" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ItemsSource="{Binding BitRateOptions}"
                                                  SelectedValue="{Binding VideoBitRate}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SESSION" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="4,16,0,7" />
                            <Border CornerRadius="10" Padding="12,2"
                                    Background="#07FFFFFF"
                                    BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <Grid MinHeight="38">
                                        <TextBlock Text="Audio du jeu sur le PC" FontSize="12" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding EnableAudio}" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="38">
                                        <TextBlock Text="Garder l'écran allumé" FontSize="12" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding StayAwake}" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="38">
                                        <TextBlock Text="Plein écran automatique" FontSize="12" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding AutoFullscreen}" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="38"
                                          ToolTip="Le texte copié sur le téléphone arrive dans le presse-papiers Windows">
                                        <TextBlock Text="Recevoir le presse-papiers du téléphone" FontSize="12" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding SyncDeviceClipboard}" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="38"
                                          ToolTip="Luminosité du téléphone au minimum pendant le mirroring — économise la batterie et préserve l'AMOLED">
                                        <TextBlock Text="Atténuer l'écran du téléphone" FontSize="12" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding TurnScreenOff}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="API LOCALE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="4,16,0,7" />
                            <Border CornerRadius="10" Padding="12,2"
                                    Background="#07FFFFFF"
                                    BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <Grid MinHeight="38"
                                          ToolTip="Pilote l'app depuis Stream Deck, OBS, scripts — aucune action possible sur le téléphone">
                                        <TextBlock Text="Activer l'API (localhost + token)" FontSize="12" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsChecked="{Binding LocalApiEnabled}" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="38">
                                        <TextBlock Text="Port" FontSize="12" VerticalAlignment="Center" />
                                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Text="{Binding LocalApiPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Border Height="1" Background="#08FFFFFF" />
                                    <Grid MinHeight="38"
                                          ToolTip="Authorization: Bearer &lt;token&gt; — ou ?token= dans l'URL">
                                        <TextBlock Text="Token" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBox Width="200" IsReadOnly="True" FontSize="10.5"
                                                     FontFamily="Consolas" VerticalContentAlignment="Center"
                                                     Text="{Binding LocalApiToken, Mode=OneWay}" />
                                            <ui:Button Margin="6,0,0,0" Padding="0" Width="26" Height="24"
                                                       Appearance="Transparent"
                                                       Command="{Binding RegenerateApiTokenCommand}"
                                                       ToolTip="Régénérer le token">
                                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="12" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontSize="10.5" Margin="2,0,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="GET /api/mirrors · POST /api/mirrors/1/activate · /record · /screenshot · GET /api/events (SSE)" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="4,16,0,7">
                                <TextBlock Text="PLUGINS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ui:Button Padding="0" Width="26" Height="24" Margin="4,0"
                                               Appearance="Transparent"
                                               Command="{Binding RescanPluginsCommand}"
                                               ToolTip="Rafraîchir la liste">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" />
                                    </ui:Button>
                                    <ui:Button Padding="0" Width="26" Height="24" Margin="4,0"
                                               Appearance="Transparent"
                                               Command="{Binding OpenPluginsFolderCommand}"
                                               ToolTip="Ouvrir le dossier plugins">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                            <Border CornerRadius="10" Padding="12,2"
                                    Background="#07FFFFFF"
                                    BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Plugins}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                                               VerticalAlignment="Top" Margin="2,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Version, StringFormat=' v{0}', FallbackValue=''}"
                                                                       FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="12"
                                                                           Foreground="#4EC98E" VerticalAlignment="Center" Margin="5,0,0,0"
                                                                           ToolTip="Plugin officiel vérifié"
                                                                           Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}" />
                                                            <ui:SymbolIcon Symbol="ShieldError24" FontSize="12"
                                                                           Foreground="#E0A24C" VerticalAlignment="Center" Margin="5,0,0,0"
                                                                           ToolTip="Non vérifié — lis le code avant de l'activer"
                                                                           Visibility="{Binding IsVerified, Converter={StaticResource NotBoolToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                                     IsChecked="{Binding Running, Mode=OneWay}"
                                                                     Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="10.5" Margin="2,6,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Dépose un plugin JS dans le dossier plugins (plugins/mon-plugin/plugin.js + plugin.json). API sandboxée : tm.getMirrors(), tm.connect(serial), tm.on('devices', fn)…" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="4,16,0,7">
                                <TextBlock Text="CATALOGUE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                                <ui:Button Padding="0" Width="26" Height="24" Margin="4,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Appearance="Transparent"
                                           Command="{Binding LoadCatalogCommand}"
                                           ToolTip="Rafraîchir le catalogue">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" />
                                </ui:Button>
                            </Grid>
                            <Border CornerRadius="10" Padding="12,2"
                                    Background="#07FFFFFF"
                                    BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Catalog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                                               VerticalAlignment="Top" Margin="2,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Meta, StringFormat=' {0}'}"
                                                                       FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="12"
                                                                           Foreground="#4EC98E" VerticalAlignment="Center" Margin="5,0,0,0"
                                                                           ToolTip="Plugin officiel — relu par l'équipe"
                                                                           Visibility="{Binding Official, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="2" VerticalAlignment="Center"
                                                               FontSize="11" Padding="10,3"
                                                               Content="{Binding ActionLabel}"
                                                               IsEnabled="{Binding CanInstall}"
                                                               Command="{Binding DataContext.InstallPluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="10.5" Margin="2,6,0,4" TextWrapping="Wrap"
                                               Foreground="#E0A24C"
                                               Text="{Binding CatalogStatus}"
                                               Visibility="{Binding CatalogStatus, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                                    <TextBlock FontSize="10.5" Margin="2,4,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Extensions publiées sur le dépôt GitHub — chaque installation est vérifiée par hash SHA-256. Un plugin communautaire installé ici redemandera ton accord s'il est modifié." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="JOURNAL" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="4,16,0,7" />
                            <Border CornerRadius="10"
                                    Background="#07FFFFFF"
                                    BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <ListBox ItemsSource="{Binding Logs}"
                                         Height="140" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         Background="Transparent" BorderThickness="0" Padding="10,8" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ Panneau aide ══ -->
            <Border x:Name="HelpPanel" Grid.Column="0"
                    Width="560"
                    Margin="14,14,0,14" CornerRadius="14"
                    Background="#F51A1E26"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HelpSlide" X="-40" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10,8,10"
                            Background="#0DFFFFFF">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4EC98E" Offset="0" />
                                            <GradientStop Color="#2E7D55" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="BookOpenGlobe24" FontSize="15"
                                                   Foreground="#0A120E"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Aide Dofus Touch" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PageTitle" Text="Sites intégrés" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                       Width="30" Height="28" Padding="0" Click="OnHelpClick">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                            </ui:Button>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="NavProgress" Grid.Row="1" Height="2" IsIndeterminate="True"
                                 Visibility="Collapsed" BorderThickness="0"
                                 Foreground="{DynamicResource DofusAccentBrush}"
                                 Background="Transparent" />

                    <WrapPanel Grid.Row="2" Margin="12,10,12,0">
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.dofus-touch.com/fr/"
                                   ToolTip="Site officiel">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Officiel" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.dofus-touch.com/fr/forum"
                                   ToolTip="Forum officiel">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Forum" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.dofus-touch.com/fr/mmorpg/encyclopedie"
                                   ToolTip="Encyclopédie officielle — items, panoplies, classes">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BookOpen24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Encyclopédie" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://dofustouchatlas.com/fr/"
                                   ToolTip="Atlas — guides, quêtes, donjons, Almanax">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CompassNorthwest24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Atlas" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://dofustouchatlas.com/mapa-dofus-touch/index.html?lang=fr"
                                   ToolTip="Carte interactive du monde">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Map24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Carte" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.krosmoz.com/fr/almanax?game=dofustouch"
                                   ToolTip="Almanax officiel — offrande et bonus du jour">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarStar24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Almanax" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://papycha.fr/quetes/"
                                   ToolTip="Guides papycha — quêtes, donjons, succès">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Guides" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://support.ankama.com/hc/fr"
                                   ToolTip="Support Ankama">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PersonQuestionMark24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Support" />
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>

                    <Border Grid.Row="3" Margin="12,4,12,10" CornerRadius="17" Height="34"
                            Background="#14FFFFFF"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1">
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavBack" ToolTip="Précédent">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" />
                            </ui:Button>
                            <ui:Button Grid.Column="1" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavForward" ToolTip="Suivant">
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" />
                            </ui:Button>
                            <ui:Button Grid.Column="2" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavReload" ToolTip="Recharger">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" />
                            </ui:Button>
                            <ui:Button Grid.Column="3" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavHome" ToolTip="Accueil — dofus-touch.com">
                                <ui:SymbolIcon Symbol="Home24" FontSize="13" />
                            </ui:Button>
                            <Border Grid.Column="4" Margin="4,0,8,0" VerticalAlignment="Center">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="12" HorizontalAlignment="Left"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBox x:Name="AddressBar" Margin="26,0,0,0" FontSize="11"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent" BorderThickness="0"
                                             KeyDown="OnAddressKeyDown" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <wv2:WebView2 x:Name="HelpBrowser" Grid.Row="4" />
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Statusbar ══ -->
        <Border Grid.Row="4"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusDotColor}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Status}" FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding WifiStatus}" FontSize="11.5" Margin="16,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="VersionText"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
