                                <ListBox ItemsSource="{Binding Logs}"
                                         Height="140" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         Background="Transparent" BorderThickness="0" Padding="10,8" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Guides Dofus Touch -->
            <Border x:Name="HelpPanel"
                    Width="560" Visibility="Collapsed" ClipToBounds="True"
                    Background="{DynamicResource AppModalBrush}">
                <Border.RenderTransform>
                    <TranslateTransform X="-24" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10,8,10"
                            Background="{DynamicResource SurfaceFaintBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="4" Margin="0,0,10,0"
                                        Background="{DynamicResource SurfaceFaintBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="BookOpenGlobe24" FontSize="15"
                                                   Foreground="{DynamicResource DofusAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Aide Dofus Touch" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PageTitle" Text="Sites intégrés" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                       Width="30" Height="28" Padding="0" Click="OnHelpClick">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                            </ui:Button>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="NavProgress" Grid.Row="1" Height="2" IsIndeterminate="True"
                                 Visibility="Collapsed" BorderThickness="0"
                                 Foreground="{DynamicResource DofusAccentBrush}"
                                 Background="Transparent" />

                    <WrapPanel Grid.Row="2" Margin="12,10,12,0">
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.dofus-touch.com/fr/"
                                   ToolTip="Site officiel">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Officiel" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.dofus-touch.com/fr/forum"
                                   ToolTip="Forum officiel">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Forum" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.dofus-touch.com/fr/mmorpg/encyclopedie"
                                   ToolTip="Encyclopédie officielle — items, panoplies, classes">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BookOpen24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Encyclopédie" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://dofustouchatlas.com/fr/"
                                   ToolTip="Atlas — guides, quêtes, donjons, Almanax">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CompassNorthwest24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Atlas" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://dofustouchatlas.com/mapa-dofus-touch/index.html?lang=fr"
                                   ToolTip="Carte interactive du monde">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Map24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Carte" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://www.krosmoz.com/fr/almanax?game=dofustouch"
                                   ToolTip="Almanax officiel — offrande et bonus du jour">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarStar24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Almanax" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://papycha.fr/quetes/"
                                   ToolTip="Guides papycha — quêtes, donjons, succès">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Guides" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="9,4" Margin="0,0,6,6" FontSize="11"
                                   Click="OnSiteClick" Tag="https://support.ankama.com/hc/fr"
                                   ToolTip="Support Ankama">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PersonQuestionMark24" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Support" />
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>

                    <Border Grid.Row="3" Margin="12,4,12,10" CornerRadius="4" Height="34"
                            Background="{DynamicResource SurfaceFaintBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1">
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavBack" ToolTip="Précédent">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" />
                            </ui:Button>
                            <ui:Button Grid.Column="1" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavForward" ToolTip="Suivant">
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" />
                            </ui:Button>
                            <ui:Button Grid.Column="2" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavReload" ToolTip="Recharger">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" />
                            </ui:Button>
                            <ui:Button Grid.Column="3" Style="{StaticResource ToolBtn}" Width="30" Height="28"
                                       Click="OnNavHome" ToolTip="Accueil — dofus-touch.com">
                                <ui:SymbolIcon Symbol="Home24" FontSize="13" />
                            </ui:Button>
                            <Border Grid.Column="4" Margin="4,0,8,0" VerticalAlignment="Center">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="12" HorizontalAlignment="Left"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBox x:Name="AddressBar" Margin="26,0,0,0" FontSize="11"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent" BorderThickness="0"
                                             KeyDown="OnAddressKeyDown" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <wv2:WebView2 x:Name="HelpBrowser" Grid.Row="4" />
                </Grid>
            </Border>

            <!-- Plugins installés -->
            <Border x:Name="PluginsPanel"
                    Width="360" Visibility="Collapsed"
                    Background="{DynamicResource AppModalBrush}">
                <Border.RenderTransform>
                    <TranslateTransform X="-24" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="16,12,10,12" Background="{DynamicResource SurfaceFaintBrush}"
                            BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,11,0"
                                        Background="{DynamicResource SurfaceFaintBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16"
                                                   Foreground="{DynamicResource DofusAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Plugins" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Plugins.Count, StringFormat='{}{0} installé(s) — sandbox JavaScript'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                       Padding="0" Width="28" Height="28"
                                       Click="OnDockClose" ToolTip="Fermer">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                            </ui:Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Padding="16,7" Background="{DynamicResource SurfaceFaintBrush}"
                            BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Chaque plugin tourne dans une sandbox — aucun accès fichiers, réseau ou input."
                                           FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Padding="0" Width="26" Height="24" Margin="4,0"
                                               Appearance="Transparent"
                                               Command="{Binding RescanPluginsCommand}"
                                               ToolTip="Rafraîchir la liste">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" />
                                    </ui:Button>
                                    <ui:Button Padding="0" Width="26" Height="24" Margin="4,0"
                                               Appearance="Transparent"
                                               Command="{Binding OpenPluginsFolderCommand}"
                                               ToolTip="Ouvrir le dossier plugins">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,8,16,14">
                                <ItemsControl ItemsSource="{Binding Plugins}"
                                              ItemTemplate="{StaticResource PluginCardTemplate}" />
                                <StackPanel Margin="0,16,0,6"
                                            Visibility="{Binding Plugins.Count, Converter={StaticResource EmptyToVis}}">
                                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="26"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Aucun plugin installé" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Installe une extension depuis le catalogue (icône boutique) ou dépose un dossier dans plugins/." />
                                </StackPanel>
                                <TextBlock FontSize="10.5" Margin="2,8,0,2" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="plugins/mon-plugin/plugin.js + plugin.json — un plugin modifié redemande ton accord avant de tourner." />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
            </Border>

            <!-- Marketplace — catalogue d'extensions -->
            <Border x:Name="MarketPanel"
                    Width="440" Visibility="Collapsed"
                    Background="{DynamicResource AppModalBrush}">
                <Border.RenderTransform>
                    <TranslateTransform X="-24" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                        <Border Padding="16,12,10,12" Background="{DynamicResource SurfaceFaintBrush}"
                                BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="StoreMicrosoft24" FontSize="14"
                                                   Margin="0,0,9,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Marketplace" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Catalog.Count, StringFormat=' · {0} extension(s)'}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ui:Button Padding="0" Width="28" Height="28" Margin="0,0,4,0"
                                               Appearance="Transparent"
                                               Command="{Binding LoadCatalogCommand}"
                                               ToolTip="Rafraîchir le catalogue">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" />
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="0" Width="28" Height="28"
                                               Click="OnDockClose" ToolTip="Fermer">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Padding="16,9" Background="{DynamicResource SurfaceFaintBrush}"
                                BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ui:TextBox PlaceholderText="Rechercher une extension…"
                                            Text="{Binding CatalogFilter, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="12" Height="30">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Search24" FontSize="13" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <ui:Button Content="Tous" FontSize="11" Padding="13,3" Margin="0,0,6,0"
                                               Command="{Binding SelectCatalogTabCommand}" CommandParameter="0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CatalogTab, ElementName=MarketPanel}" Value="0">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button Content="Officiels" FontSize="11" Padding="13,3" Margin="0,0,6,0"
                                               Command="{Binding SelectCatalogTabCommand}" CommandParameter="1">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CatalogTab, ElementName=MarketPanel}" Value="1">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button Content="Installés" FontSize="11" Padding="13,3"
                                               Command="{Binding SelectCatalogTabCommand}" CommandParameter="2">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CatalogTab, ElementName=MarketPanel}" Value="2">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelectedPlugin, Converter={StaticResource NotBoolToVis}}">
                            <StackPanel Margin="6,2,6,10">
                                <ItemsControl ItemsSource="{Binding CatalogView}"
                                              ItemTemplate="{StaticResource CatalogCardTemplate}" />
                                <StackPanel Margin="0,16,0,6"
                                            Visibility="{Binding CatalogView.Count, Converter={StaticResource EmptyToVis}}">
                                    <ui:SymbolIcon Symbol="StoreMicrosoft24" FontSize="26"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Aucun résultat" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Essaie un autre filtre ou rafraîchis le catalogue avec ↻." />
                                </StackPanel>
                                <TextBlock FontSize="10.5" Margin="2,6,0,2" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarnBrush}"
                                           Text="{Binding CatalogStatus}"
                                           Visibility="{Binding CatalogStatus, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                                <TextBlock FontSize="10.5" Margin="2,8,0,2" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Extensions relues et signées par l'équipe TouchMirror — elles ne peuvent ni lire tes fichiers, ni injecter d'input vers le téléphone." />
                            </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelectedPlugin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="16,6,16,14">
                                    <ui:Button Appearance="Transparent" Padding="8,4" HorizontalAlignment="Left"
                                               Command="{Binding BackToCatalogCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="11"
                                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Catalogue" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="4" Margin="0,0,13,0"
                                                Background="{DynamicResource SurfaceFaintBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SelectedPlugin.Icon}" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedPlugin.Meta}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Border Padding="5,1" CornerRadius="3" Margin="0,0,6,0"
                                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                                        Visibility="{Binding SelectedPlugin.Official, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="9"
                                                                       Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Officiel" FontSize="8.5" Foreground="{DynamicResource DofusAccentBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Padding="5,1" CornerRadius="3" Margin="0,0,6,0"
                                                        BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                                        Visibility="{Binding SelectedPlugin.Official, Converter={StaticResource NotBoolToVis}}">
                                                    <TextBlock Text="Communautaire" FontSize="8.5" Foreground="{DynamicResource WarnBrush}" />
                                                </Border>
                                                <Border Padding="5,1" CornerRadius="3"
                                                        BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1"
                                                        Visibility="{Binding SelectedPlugin.Featured, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Recommandé" FontSize="8.5" Foreground="{DynamicResource GoldBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Grid>
                                                <ui:Button Appearance="Primary" FontSize="11" Padding="14,5"
                                                           Content="{Binding SelectedPlugin.ActionLabel}"
                                                           IsEnabled="{Binding SelectedPlugin.CanInstall}"
                                                           Command="{Binding InstallPluginCommand}"
                                                           CommandParameter="{Binding SelectedPlugin}"
                                                           Visibility="{Binding SelectedPlugin.IsInstalled, Converter={StaticResource NotBoolToVis}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                            Visibility="{Binding SelectedPlugin.IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="12"
                                                                   Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Installé" FontSize="10.5" Foreground="{DynamicResource DofusAccentBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                                            Background="{DynamicResource SurfaceFaintBrush}" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1"
                                            Visibility="{Binding SelectedPlugin.IsPresent, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="● actif" FontSize="10.5" VerticalAlignment="Center"
                                                       Margin="0,0,10,0" Foreground="{DynamicResource DofusAccentBrush}"
                                                       Visibility="{Binding SelectedPlugin.IsActive, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="○ inactif" FontSize="10.5" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding SelectedPlugin.IsActive, Converter={StaticResource NotBoolToVis}}" />
                                            <ui:Button Appearance="Secondary" FontSize="10.5" Padding="10,3" Margin="0,0,6,0"
                                                       Content="{Binding SelectedPlugin.ToggleLabel}"
                                                       Command="{Binding ToggleCatalogPluginCommand}"
                                                       CommandParameter="{Binding SelectedPlugin}" />
                                            <ui:Button Appearance="Transparent" FontSize="10.5" Padding="10,3"
                                                       Content="Désinstaller"
                                                       Command="{Binding UninstallCatalogPluginCommand}"
                                                       CommandParameter="{Binding SelectedPlugin}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedPlugin.Description}" FontSize="11"
                                               TextWrapping="Wrap" Margin="1,10,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <TextBlock Text="CAPACITÉS" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding SelectedPlugin.Capabilities}" Margin="0,3,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="10.5" Margin="2,1" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="· " /><Run Text="{Binding}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="10" Margin="2,7,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Sandbox : aucun accès fichiers, réseau, processus — aucune injection tactile/clavier vers le téléphone." />
                                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <TextBlock Text="SHA-256" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="1,3,0,0">
                                        <TextBlock Text="{Binding SelectedPlugin.ShortHash}" FontFamily="Consolas"
                                                   FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Appearance="Transparent" Padding="0" Width="26" Height="24"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Click="OnCopyPluginHash" ToolTip="Copier le hash complet">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="12" />
                                        </ui:Button>
                                    </StackPanel>
                                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <TextBlock Text="CODE SOURCE" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <Border Margin="0,5,0,0" Padding="10,8" CornerRadius="4"
                                            Background="{DynamicResource CodeBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <ScrollViewer MaxHeight="230"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding SelectedPlugin.Code}" FontFamily="Consolas"
                                                           FontSize="10.5" TextWrapping="NoWrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </ScrollViewer>
                                            <TextBlock Text="chargement du code…" FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding SelectedPlugin.CodeBusy, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="code indisponible hors-ligne — affiché après installation"
                                                       FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                                       Visibility="{Binding SelectedPlugin.CodeError, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock FontSize="10" Margin="1,10,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Le hash ci-dessus identifie exactement ce code — toute modification redemandera ton accord." />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                </Grid>
            </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ══ Statusbar ══ -->
        <Border Grid.Row="5"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,5">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Status}" FontSize="10.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding WifiStatus}" FontSize="10.5" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="VersionText"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
