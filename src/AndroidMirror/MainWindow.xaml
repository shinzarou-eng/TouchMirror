<ui:FluentWindow x:Class="TouchMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:TouchMirror.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:TouchMirror"
        xmlns:loc="clr-namespace:TouchMirror.Services"
        mc:Ignorable="d"
        Title="TouchMirror" Icon="assets/mascot.png"
        MinWidth="1060" MinHeight="560" Width="1280" Height="800"
        FontFamily="Segoe UI Variable Text"
        WindowBackdropType="Mica"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding Topmost}"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        PreviewTextInput="OnPreviewTextInput">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:SymToIconConverter x:Key="SymToIcon" />
        <local:HexToSoftConverter x:Key="HexSoft" />
        <local:AnyBoolToVisibilityConverter x:Key="AnyBoolToVis" />
        <local:IndexPlusOneConverter x:Key="ChNum" />
        <local:EqualsConverter x:Key="EqConv" />
        <local:BytesToImageConverter x:Key="BytesToImage" />

        <Storyboard x:Key="BotIdle" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LidLS" Storyboard.TargetProperty="ScaleY" Duration="0:0:5">
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:4.4" />
                <SplineDoubleKeyFrame Value="1" KeyTime="0:0:4.52" />
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:4.62" />
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:4.74" />
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:4.82" />
                <SplineDoubleKeyFrame Value="1" KeyTime="0:0:4.9" />
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:5" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LidDS" Storyboard.TargetProperty="ScaleY" Duration="0:0:5" BeginTime="0:0:0.06">
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:4.4" />
                <SplineDoubleKeyFrame Value="1" KeyTime="0:0:4.52" />
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:4.62" />
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:4.74" />
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:4.82" />
                <SplineDoubleKeyFrame Value="1" KeyTime="0:0:4.9" />
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:5" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="BotBreathe" Storyboard.TargetProperty="Y"
                             From="0" To="-1.6" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BotSway" Storyboard.TargetProperty="Angle" Duration="0:0:8" RepeatBehavior="Forever">
                <SplineDoubleKeyFrame Value="2.2" KeyTime="0:0:2" />
                <SplineDoubleKeyFrame Value="-1.8" KeyTime="0:0:4.8" />
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:8" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Eq1" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Eq2" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:1.15" BeginTime="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Eq3" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:0.75" BeginTime="0:0:0.36" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Eq4" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:1.3" BeginTime="0:0:0.1" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Eq5" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:1.0" BeginTime="0:0:0.28" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>

        <Style x:Key="PluginTgl" TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}" />

        <Style x:Key="PillBtn" TargetType="ui:Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtnAccent" TargetType="ui:Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0,5,0" />
            <Setter Property="FontSize" Value="{StaticResource FsMeta}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <ContentPresenter Margin="0,0,18,0" IsHitTestVisible="False"
                                                        Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                        ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                        ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                        ContentStringFormat="{Binding ItemStringFormat, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                        HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                        VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}" />
                                                <Path Style="{StaticResource Ic}" Data="{StaticResource IcChevronDown24}" Width="10" Height="10" IsHitTestVisible="False"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="5"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource AppModalBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="False" Padding="3">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="{StaticResource FsMeta}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Margin="1" Padding="{TemplateBinding Padding}"
                                CornerRadius="5" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
        </Style>

        <Style x:Key="BtnPrimary" TargetType="ui:Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{DynamicResource AccentButtonBorderBrush}" BorderThickness="1"
                                Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.35" />
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="6" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2BFFFFFF" Offset="0" />
                                            <GradientStop Color="#0AFFFFFF" Offset="0.42" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.58" />
                                            <GradientStop Color="#14000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Glow" CornerRadius="6" Background="#1EFFFFFF" Opacity="0" IsHitTestVisible="False" />
                                <Rectangle Height="1" VerticalAlignment="Top" Margin="9,1" Opacity="0.55" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#7AFFFFFF" Offset="0.18" />
                                            <GradientStop Color="#7AFFFFFF" Offset="0.82" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DofusAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAction" TargetType="ui:Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Glow" CornerRadius="6" Background="#10FFFFFF" Opacity="0" IsHitTestVisible="False" />
                                <Rectangle Height="1" VerticalAlignment="Top" Margin="9,1" Opacity="0.4" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#3DFFFFFF" Offset="0.18" />
                                            <GradientStop Color="#3DFFFFFF" Offset="0.82" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShowMirrorSurface, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavTile" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource IconTileBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,11,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.ShowMirrorSurface, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShowMirrorSurface, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PinnedShift" TargetType="Border">
            <Setter Property="Margin" Value="10" />
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FsMeta}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickTile" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Ellipse x:Name="dot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{DynamicResource TextFillColorDisabledBrush}" Opacity="0.5" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12C9D1D9" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource DofusAccentBrush}" />
                                <Setter TargetName="dot" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsMeta}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileCap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ValTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
        </Style>

        <Style x:Key="ValTileLab" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
