                                        Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="RailDiagTile" Style="{StaticResource NavTile}">
                                        <Path Style="{StaticResource Ic}" x:Name="RailDiagIcon" Data="{StaticResource IcShieldCheckmark24}" Width="14" Height="14"
                                                       Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc dbg.title}" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button x:Name="RailSettings" Style="{StaticResource NavItem}"
                                   Click="OnSettingsClick" ToolTip="{loc:Loc reglages}">
                            <Grid>
                                <Border x:Name="RailSettingsIndicator" Width="3" Height="16" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0"
                                        Background="{DynamicResource DofusAccentBrush}"
                                        Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="RailSettingsTile" Style="{StaticResource NavTile}">
                                        <Path Style="{StaticResource Ic}" x:Name="RailSettingsIcon" Data="{StaticResource IcSettings24}" Width="14" Height="14"
                                                       Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc reglages}" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </Grid>
