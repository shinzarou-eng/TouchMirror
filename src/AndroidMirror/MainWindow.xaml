                            <Path Style="{StaticResource Ic}" Data="{StaticResource IcDocumentText24}" Width="11" Height="11"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{DynamicResource TextFillColorTertiaryBrush}" />
