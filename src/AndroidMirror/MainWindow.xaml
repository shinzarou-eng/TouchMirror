                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="Transparent"
                BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="16,8"
                Visibility="{Binding ShowMirrorSurface, Converter={StaticResource NotBoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FsCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WifiStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WifiStatus}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="1" Height="10" Margin="10,0,9,0"
                                Background="{DynamicResource AppBorderSubtleBrush}"
                                VerticalAlignment="Center" />
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IcWifi124}" Width="12" Height="12" Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding WifiStatus}" FontSize="{StaticResource FsCaption}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
