                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform Y="8" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FsMeta}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding WifiStatus}" FontSize="{StaticResource FsMeta}" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Border Width="1" Height="10" Margin="10,0,9,0"
                            Background="{DynamicResource AppBorderSubtleBrush}"
                            VerticalAlignment="Center" />
