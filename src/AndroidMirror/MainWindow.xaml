<ui:FluentWindow x:Class="TouchMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:TouchMirror.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:TouchMirror"
        xmlns:loc="clr-namespace:TouchMirror.Services"
        mc:Ignorable="d"
        Title="TouchMirror" Icon="assets/mascot.png"
        MinWidth="1060" MinHeight="560" Width="1280" Height="800"
        FontFamily="Segoe UI Variable Text"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding Topmost}"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        PreviewTextInput="OnPreviewTextInput">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:AnyBoolToVisibilityConverter x:Key="AnyBoolToVis" />

        <Style x:Key="ToolBtn" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusBadge}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3ECF8E" />
                                <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C50F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QCard" TargetType="ui:Card"
               BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="15,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>

        <DataTemplate x:Key="PluginCardTemplate">
            <Border Margin="0,3" Padding="11,9" CornerRadius="{StaticResource RadiusPanel}"
                    Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Running}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,11,0"
                            Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="17"
                                       Foreground="{DynamicResource DofusAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Version, StringFormat=' v{0}', FallbackValue=''}"
                                       FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="12"
                                           Foreground="{DynamicResource DofusAccentBrush}" VerticalAlignment="Center" Margin="5,0,0,0"
                                           ToolTip="{loc:Loc plugin_officiel_verifie}"
                                           Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="ShieldError24" FontSize="12"
                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="5,0,0,0"
                                           ToolTip="{loc:Loc non_verifie_lis_le_code_avant_de_l_activer}"
                                           Visibility="{Binding IsVerified, Converter={StaticResource NotBoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Padding="4,2" Margin="0,0,2,0"
                                       VerticalAlignment="Center"
                                       Click="OnPluginDetailClick"
                                       ToolTip="{loc:Loc details}">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" />
                            </ui:Button>
                            <ui:ToggleSwitch HorizontalAlignment="Right"
                                             IsChecked="{Binding Running, Mode=OneWay}"
                                             Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc actif}" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource DofusAccentBrush}" HorizontalAlignment="Right"
                                   Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CatalogCardTemplate">
            <Border Padding="12,11" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,12,0"
                            Background="{DynamicResource SurfaceFaintBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Meta, StringFormat=' · {0}'}"
                                       FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Padding="5,1" CornerRadius="{StaticResource RadiusBadge}" Margin="6,1,0,1"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding Official, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="11"
                                                   Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc officiel}" FontSize="11" Foreground="{DynamicResource DofusAccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,1" CornerRadius="{StaticResource RadiusBadge}" Margin="6,1,0,1"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding Featured, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc recommande}" FontSize="11" Foreground="{DynamicResource GoldBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5,1" CornerRadius="{StaticResource RadiusBadge}" Margin="0,0,5,0"
                                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Mode=OneWay}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid>
                            <ui:Button Appearance="Primary" FontSize="12" Padding="12,4"
                                       Content="{Binding ActionLabel}"
                                       IsEnabled="{Binding CanInstall}"
                                       Command="{Binding DataContext.InstallPluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding IsInstalled, Converter={StaticResource NotBoolToVis}}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="12"
                                               Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc installe}" FontSize="12.5" Foreground="{DynamicResource DofusAccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ui:Button Appearance="Transparent" Padding="6,2" Margin="0,3,0,0"
                                   HorizontalAlignment="Right"
                                   Command="{Binding DataContext.SelectPluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="{loc:Loc voir_la_fiche_detail}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc details}" FontSize="12" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12"
                                               Margin="3,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ChromeRow" Height="Auto" />
            <RowDefinition x:Name="ContextRow" Height="Auto" />
            <RowDefinition x:Name="UpdateRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusBarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarElement" Grid.Row="0" Height="48"
                Background="{DynamicResource AppGlassSurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <Image Source="assets/mascot.png" Width="17" Height="17" Margin="0,0,9,0" />
                    <TextBlock x:Name="Wordmark" VerticalAlignment="Center" FontSize="13.5"
                               FontFamily="Bahnschrift" FontWeight="SemiBold">
                        <Run Text="Touch" /><Run Text="Mirror" Foreground="{DynamicResource DofusAccentBrush}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="86" MaxWidth="140" Height="28" Padding="9,0,5,0"
                                        Margin="0,0,4,0" CornerRadius="{StaticResource RadiusControl}"
                                        MouseLeftButtonUp="OnWorkspaceTabClick"
                                        ToolTip="{loc:Loc basculer_vers_cet_espace_clic_droit_gerer_ctrl_m}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="1,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 Fill="{DynamicResource DofusAccentBrush}"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsMeta}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="92"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource NotBoolToVis}}" />
                                            <TextBox Text="{Binding Name, Mode=OneWay}" MinWidth="50" Padding="0"
                                                     FontSize="{StaticResource FsMeta}" VerticalAlignment="Center"
                                                     Background="Transparent" BorderThickness="0"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                     KeyDown="OnWorkspaceNameKeyDown"
                                                     LostFocus="OnWorkspaceNameLostFocus"
                                                     IsVisibleChanged="OnWorkspaceNameVisible" />
                                            <TextBlock Text="{Binding DeviceCount, StringFormat=' · {0}'}"
                                                       FontSize="{StaticResource FsCaption}" Margin="3,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeviceCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                                   Width="20" Height="18" Padding="0" VerticalAlignment="Center"
                                                   Click="OnWorkspaceDeleteClick" ToolTip="{loc:Loc supprimer_cet_espace}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource AnyBoolToVis}">
                                                    <Binding Path="IsActive" />
                                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=Border}" />
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                                        </ui:Button>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc renommer}" Click="OnWorkspaceEditClick" />
                                            <MenuItem Header="{loc:Loc dupliquer}" Click="OnWorkspaceDuplicateClick" />
                                            <Separator Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="{loc:Loc quitter_l_espace}" Click="OnWorkspaceExitClick"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Loc supprimer}" Click="OnWorkspaceDeleteClick"
                                                      Foreground="{DynamicResource DangerBrush}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Appearance="Transparent" Height="28" Padding="10,0" Margin="2,0,0,0"
                               Command="{Binding NewWorkspaceCommand}"
                               ToolTip="{loc:Loc nouvel_espace_memorise_appareils_ordre_miroir_ac}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Loc nouvel_espace}" FontSize="{StaticResource FsCaption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
                    <ui:SymbolIcon Symbol="Phone24" FontSize="15" Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              Width="172" MaxWidth="172" MinWidth="104" Height="30"
                              FontSize="{StaticResource FsMeta}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ShortName}" />
                                    <TextBlock Text="{Binding SelectorHint}" FontSize="{StaticResource FsCaption}"
                                               Margin="6,1,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Style="{StaticResource ToolBtn}" Height="30" Margin="4,0,0,0"
                               Command="{Binding RefreshDevicesCommand}"
                               ToolTip="{loc:Loc rafraichir_les_appareils}">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                    </ui:Button>
                    <ui:Button Appearance="Primary"
                               Command="{Binding ConnectCommand}"
                               IsEnabled="{Binding CanConnect}"
                               Margin="8,0,0,0" Padding="14,0" Height="30"
                               FontSize="{StaticResource FsMeta}" FontWeight="SemiBold"
                               Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource NotBoolToVis}}">
                                <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Loc connecter}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="13" Height="13"
                                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc connexion}" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ConnectCommand}"
                               IsEnabled="{Binding CanConnect}"
                               Padding="12,0" Height="30" Margin="8,0,0,0"
                               FontSize="{StaticResource FsMeta}" FontWeight="SemiBold"
                               ToolTip="{loc:Loc ajouter_un_autre_telephone_a_la_grille_multicomp}"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0"
                                           Foreground="{DynamicResource DofusAccentBrush}" />
                            <TextBlock Text="{loc:Loc ajouter}" Foreground="{DynamicResource DofusAccentBrush}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Click="OnMinimizeClick" ToolTip="{loc:Loc reduire}">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="OnMaximizeClick" ToolTip="{loc:Loc agrandir_restaurer}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtn}" Click="OnCloseClick" ToolTip="{loc:Loc fermer}">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" x:Name="ContextBar"
                Background="{DynamicResource AppGlassAltBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="14,6"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="1,0,10,0"
                             Fill="{Binding ActiveMirror.AccentHex, Converter={StaticResource HexToBrush}}"
                             Visibility="{Binding ActiveMirror.IsConnected, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ActiveMirror.DeviceName, Mode=OneWay}"
                               FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}"
                             VerticalAlignment="Center" Margin="10,0,0,0"
                             Visibility="{Binding ActiveMirror.IsRecording, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToolToggle}" Height="32"
                                  IsChecked="{Binding KeybindEditMode, Mode=TwoWay}"
                                  ToolTip="{loc:Loc raccourcis_plaques_sur_l_ecran_une_touche_un_tap}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:Loc raccourcis}" />
                        </StackPanel>
                    </ToggleButton>
                    <ComboBox Width="92" Margin="6,0,0,0" Height="28" FontSize="{StaticResource FsCaption}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding KeybindProfiles}"
                              SelectedItem="{Binding SelectedKeybindProfile}"
                              DisplayMemberPath="Name"
                              ToolTip="{loc:Loc profil_de_raccourcis}" />
                    <ui:Button Style="{StaticResource ToolBtn}" Width="26" Height="28" Margin="4,0,0,0"
                               Command="{Binding NewKeybindProfileCommand}"
