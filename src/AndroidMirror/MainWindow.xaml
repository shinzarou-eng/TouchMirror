                                                            <Setter Property="Height" Value="34" />
                                                            <Setter Property="CornerRadius" Value="5" />
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
