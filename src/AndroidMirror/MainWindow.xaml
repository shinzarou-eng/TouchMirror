<ui:FluentWindow x:Class="TouchMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:TouchMirror.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:TouchMirror"
        mc:Ignorable="d"
        Title="TouchMirror" Icon="assets/mascot.png"
        MinWidth="1060" MinHeight="560" Width="1280" Height="800"
        FontFamily="Segoe UI Variable Text"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding Topmost}"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        PreviewTextInput="OnPreviewTextInput">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="ToolBtn" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3ECF8E" />
                                <Setter Property="Foreground" Value="{DynamicResource DofusAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C50F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QCard" TargetType="ui:Card"
               BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="15,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>

        <DataTemplate x:Key="PluginCardTemplate">
            <Border Margin="0,3" Padding="11,9" CornerRadius="6"
                    Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="4" Margin="0,0,11,0"
                            Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Icon}" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Version, StringFormat=' v{0}', FallbackValue=''}"
                                       FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="12"
                                           Foreground="{DynamicResource DofusAccentBrush}" VerticalAlignment="Center" Margin="5,0,0,0"
                                           ToolTip="Plugin officiel vérifié"
                                           Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="ShieldError24" FontSize="12"
                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="5,0,0,0"
                                           ToolTip="Non vérifié — lis le code avant de l'activer"
                                           Visibility="{Binding IsVerified, Converter={StaticResource NotBoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding Running, Mode=OneWay}"
                                         Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         CommandParameter="{Binding}" />
                        <TextBlock Text="actif" FontSize="9.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource DofusAccentBrush}" HorizontalAlignment="Right"
                                   Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CatalogCardTemplate">
            <Border Padding="12,11" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="4" Margin="0,0,12,0"
                            Background="{DynamicResource SurfaceFaintBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Icon}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Meta, StringFormat=' · {0}'}"
                                       FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Padding="5,1" CornerRadius="3" Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding Official, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="9"
                                                   Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Officiel" FontSize="8.5" Foreground="{DynamicResource DofusAccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,1" CornerRadius="3" Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding Featured, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Recommandé" FontSize="8.5" Foreground="{DynamicResource GoldBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="10.5" TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5,1" CornerRadius="3" Margin="0,0,5,0"
                                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding}" FontSize="9"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid>
                            <ui:Button Appearance="Primary" FontSize="11" Padding="12,4"
                                       Content="{Binding ActionLabel}"
                                       IsEnabled="{Binding CanInstall}"
                                       Command="{Binding DataContext.InstallPluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding IsInstalled, Converter={StaticResource NotBoolToVis}}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="12"
                                               Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Installé" FontSize="10.5" Foreground="{DynamicResource DofusAccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ui:Button Appearance="Transparent" Padding="6,2" Margin="0,3,0,0"
                                   HorizontalAlignment="Right"
                                   Command="{Binding DataContext.SelectPluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="Voir la fiche détail">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Détails" FontSize="10" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="10"
                                               Margin="3,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="Auto" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition x:Name="TabsRow" Height="Auto" />
            <RowDefinition x:Name="UpdateRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusBarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Barre de titre custom (fine) ══ -->
        <Border x:Name="TitleBarElement" Grid.Row="0" Height="32"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="assets/mascot.png" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="TouchMirror" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionBtn}" Click="OnMinimizeClick" ToolTip="Réduire">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="OnMaximizeClick" ToolTip="Agrandir / restaurer">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtn}" Click="OnCloseClick" ToolTip="Fermer">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

                <!-- ══ Toolbar ══ -->
        <Border Grid.Row="1" x:Name="Toolbar"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Phone24" FontSize="14" Margin="2,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              Width="205" MaxWidth="205" MinWidth="110"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ShortName}" />
                                    <TextBlock Text="{Binding SelectorHint}" FontSize="10.5"
                                               Margin="6,1,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Style="{StaticResource ToolBtn}"
                               Margin="6,0,0,0"
                               Command="{Binding RefreshDevicesCommand}"
                               ToolTip="Rafraîchir les appareils">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                    </ui:Button>
                    <ui:Button Appearance="Primary"
                               Command="{Binding ConnectCommand}"
                               IsEnabled="{Binding CanConnect}"
                               Margin="10,0,0,0" Padding="16,0" Height="30"
                               FontWeight="SemiBold"
                               Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource NotBoolToVis}}">
                                <ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Connecter" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Connexion…" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <ui:Button Command="{Binding ConnectCommand}"
                                   IsEnabled="{Binding CanConnect}"
                                   Padding="12,0" Height="30"
                                   FontWeight="SemiBold"
                                   ToolTip="Ajouter un autre téléphone à la grille (multicompte)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="15" Margin="0,0,6,0"
                                               Foreground="{DynamicResource DofusAccentBrush}" />
                                <TextBlock Text="Ajouter" Foreground="{DynamicResource DofusAccentBrush}" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="4" Padding="2"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource ToolBtn}" Height="26" Command="{Binding SendBackCommand}" ToolTip="Retour">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ToolBtn}" Height="26" Command="{Binding SendHomeCommand}" ToolTip="Accueil Android">
                                    <ui:SymbolIcon Symbol="Home24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ToolBtn}" Height="26" Command="{Binding SendRecentsCommand}" ToolTip="Récents">
                                    <ui:SymbolIcon Symbol="SquareMultiple24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ToolBtn}" Height="26" Padding="8,0" Width="Auto"
                                           Command="{Binding LaunchDofusCommand}"
                                           ToolTip="Lancer Dofus Touch sur le téléphone affiché">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Games24" FontSize="15"
                                                       Foreground="{DynamicResource DofusAccentBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="Dofus" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="4" Padding="2" Margin="8,0,0,0"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <ToggleButton Style="{StaticResource ToolToggle}"
                                          IsChecked="{Binding KeybindEditMode, Mode=TwoWay}"
                                          ToolTip="Raccourcis plaqués sur l'écran — une touche = un tap à cet endroit">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Raccourcis" />
                                </StackPanel>
                            </ToggleButton>
                        </Border>

                        <Border CornerRadius="4" Padding="2" Margin="8,0,0,0"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsActiveMirrorIos, Converter={StaticResource BoolToVis}}">
                            <ToggleButton Style="{StaticResource ToolToggle}"
                                          IsChecked="{Binding IosBleActive, Mode=OneWay}"
                                          Command="{Binding ToggleIosBleCommand}"
                                          ToolTip="Contrôle tactile par Bluetooth — iPhone : Réglages → Accessibilité → Toucher → AssistiveTouch → Appareils → jumele ce PC">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Bluetooth24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="iPhone" />
                                </StackPanel>
                            </ToggleButton>
                        </Border>

                        <Border CornerRadius="4" Padding="2" Margin="8,0,0,0"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <ui:Button Style="{StaticResource ToolBtn}" Height="26" Width="Auto" Padding="10,0"
                                       Margin="0"
                                       Click="OnMoreClick" ToolTip="Captures et enregistrement">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Camera24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Capturer" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Capture PNG (Images\TouchMirror)"
                                                  Command="{Binding ScreenshotCommand}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Camera24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Enregistrer en vidéo (Vidéos\TouchMirror)"
                                                  Command="{Binding ToggleRecordingCommand}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Record24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Ouvrir le dossier des captures" Click="OnOpenCapturesClick">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </Border>

                        <Border CornerRadius="4" Padding="2" Margin="8,0,0,0"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <ui:Button Style="{StaticResource ToolBtn}" Height="26" Width="Auto" Padding="10,0"
                                       Margin="0"
                                       Click="OnMoreClick" ToolTip="Affichage et disposition">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Affichage" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Plein écran (F11)" Click="OnFullscreenClick">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Tourner l'image affichée" Click="OnRotateDisplayClick">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Pivoter l'écran du téléphone"
                                                  Command="{Binding RotateDeviceCommand}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="PhoneScreenTime24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Fenêtre au-dessus des autres" IsCheckable="True"
                                                  IsChecked="{Binding Topmost}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Pin24" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </Border>

                        <Border CornerRadius="4" Padding="2" Margin="8,0,0,0"
                                Background="{DynamicResource DangerSubtleBrush}" BorderBrush="{DynamicResource DangerSubtleBrush}" BorderThickness="1"
                                Visibility="{Binding RecordingVisibility}">
                            <ui:Button Style="{StaticResource ToolBtn}" Height="26" Width="Auto" Padding="8,0"
                                       Command="{Binding ToggleRecordingCommand}"
                                       ToolTip="Arrêter l'enregistrement">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding RecordingElapsed}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </ui:Button>
                        </Border>
                    </StackPanel>

                    <ui:Button Style="{StaticResource ToolBtn}" Click="OnMoreClick" ToolTip="Plus" Margin="8,0,0,0">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="15" />
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Activer le WiFi (mirroring sans câble)"
                                          Command="{Binding EnableWifiCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Wifi124" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Éteindre/allumer l'écran du téléphone"
                                          Command="{Binding SendPowerCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Phone24" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem IsEnabled="False"
                                          ToolTip="Mirroring iOS par AirPlay — en cours de développement">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="iPhone" />
                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentSubtleBrush}"
                                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="BIENTÔT" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DofusAccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="PhoneScreenTime24" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Mode Dofus (preset optimal)"
                                          Command="{Binding ApplyDofusPresetCommand}"
                                          ToolTip="1080p · 60 fps · 24 Mbps H.264 · audio · écran atténué — une seule reconnexion"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource DofusAccentBrush}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Flash24" FontSize="14"
                                                                  Foreground="{DynamicResource DofusAccentBrush}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Mode capture (cache le badge fps — pour OBS/stream)"
                                          IsCheckable="True" Click="OnCaptureModeClick" />
                                <Separator />
                                <MenuItem Header="Déconnecter ce téléphone"
                                          Command="{Binding DisconnectCommand}"
                                          Foreground="{DynamicResource DangerBrush}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="14"
                                                                  Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Onglets espaces de travail ══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <ItemsControl ItemsSource="{Binding Workspaces}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="110" MaxWidth="190" Height="31" Padding="10,0,6,0"
                                    Margin="0,0,4,0" CornerRadius="4,4,0,0"
                                    MouseLeftButtonUp="OnWorkspaceTabClick"
                                    ToolTip="Basculer vers cet espace · clic droit : gérer · Ctrl+Maj+N">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceFaintBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AppWindowBrush}" />
                                                <Setter Property="BorderThickness" Value="1,1,1,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Border Height="2" VerticalAlignment="Top" Margin="-1,0"
                                            Background="{DynamicResource DofusAccentBrush}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="11" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource NotBoolToVis}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="110"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource NotBoolToVis}}" />
                                        <TextBox Text="{Binding Name, Mode=OneWay}" MinWidth="50" Padding="0"
                                                 FontSize="11.5" VerticalAlignment="Center"
                                                 Background="Transparent" BorderThickness="0"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                 KeyDown="OnWorkspaceNameKeyDown"
                                                 LostFocus="OnWorkspaceNameLostFocus"
                                                 IsVisibleChanged="OnWorkspaceNameVisible" />
                                        <TextBlock Text="{Binding DeviceCount, StringFormat=' · {0}'}"
                                                   FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                               Width="20" Height="18" Padding="0" VerticalAlignment="Center"
                                               Click="OnWorkspaceDeleteClick" ToolTip="Supprimer cet espace"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="9" />
                                    </ui:Button>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Renommer" Click="OnWorkspaceEditClick" />
                                        <MenuItem Header="Dupliquer" Click="OnWorkspaceDuplicateClick" />
                                        <Separator Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Quitter l'espace" Click="OnWorkspaceExitClick"
                                                  Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        <Separator />
                                        <MenuItem Header="Supprimer" Click="OnWorkspaceDeleteClick"
                                                  Foreground="{DynamicResource DangerBrush}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Appearance="Transparent" Height="26" Padding="9,0" Margin="2,0,0,3"
                           Command="{Binding NewWorkspaceCommand}"
                           ToolTip="Nouvel espace — mémorise appareils, ordre, miroir actif et réglages par appareil">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Nouvel espace" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:Button>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" Margin="0,0,4,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="Ctrl" /><Run Text=" + Maj + 1-9" /><Run Text=" : basculer" />
                </TextBlock>
            </Grid>
        </Border>

<!-- ══ Bandeau mise à jour ══ -->
        <Border Grid.Row="3" Padding="16,8"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Visibility="{Binding UpdateBannerVisibility}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14"
                               Foreground="{DynamicResource DofusAccentBrush}"
                               VerticalAlignment="Center" />
                <TextBlock FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center">
                    <Run Text="Nouvelle version disponible — v" />
                    <Run Text="{Binding UpdateVersion}" FontWeight="SemiBold" />
                </TextBlock>
                <ui:Button Appearance="Primary" Height="26" Padding="12,0" Margin="10,0,0,0"
                           FontSize="12" FontWeight="SemiBold"
                           Command="{Binding OpenUpdateCommand}">
                    Télécharger
                </ui:Button>
                <ui:Button Style="{StaticResource ToolBtn}" Command="{Binding DismissUpdateCommand}"
                           ToolTip="Ignorer">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- ══ Contenu ══ -->
        <Grid Grid.Row="4" Background="{DynamicResource AppWindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══ Rail d'activité ══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource AppBorderBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <ui:Button x:Name="RailGuides" Appearance="Transparent"
                                   Width="46" Height="46" Padding="0"
                                   Click="OnHelpClick" ToolTip="Guides Dofus Touch">
                            <Grid>
                                <Border x:Name="RailGuidesIndicator" Width="2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource DofusAccentBrush}"
                                        Visibility="Collapsed" />
                                <ui:SymbolIcon Symbol="BookOpenGlobe24" FontSize="17" />
                            </Grid>
                        </ui:Button>
                        <ui:Button x:Name="RailPlugins" Appearance="Transparent"
                                   Width="46" Height="46" Padding="0"
                                   Click="OnPluginsClick" ToolTip="Plugins">
                            <Grid>
                                <Border x:Name="RailPluginsIndicator" Width="2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource DofusAccentBrush}"
                                        Visibility="Collapsed" />
                                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="17" />
                            </Grid>
                        </ui:Button>
                        <ui:Button x:Name="RailMarket" Appearance="Transparent"
                                   Width="46" Height="46" Padding="0"
                                   Click="OnCatalogClick" ToolTip="Marketplace">
                            <Grid>
                                <Border x:Name="RailMarketIndicator" Width="2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource DofusAccentBrush}"
                                        Visibility="Collapsed" />
                                <ui:SymbolIcon Symbol="StoreMicrosoft24" FontSize="17" />
                            </Grid>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Border Height="1" Margin="9,0,9,6"
                                Background="{DynamicResource AppBorderSubtleBrush}" />
                        <ui:Button x:Name="RailSettings" Appearance="Transparent"
                                   Width="46" Height="46" Padding="0"
                                   Click="OnSettingsClick" ToolTip="Réglages">
                            <Grid>
                                <Border x:Name="RailSettingsIndicator" Width="2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource DofusAccentBrush}"
                                        Visibility="Collapsed" />
                                <ui:SymbolIcon Symbol="Settings24" FontSize="17" />
                            </Grid>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="VideoFrame" Grid.Column="2"
                    Margin="12" CornerRadius="6"
                    Background="Black"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Miroir actif -->
                    <Border CornerRadius="4" Margin="4" Background="Black"
                            BorderBrush="{Binding ActiveMirror.AccentHex, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <ContentPresenter Content="{Binding ActiveMirror.View}" />

                            <Border VerticalAlignment="Top" Padding="10,5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#D0101216" Offset="0" />
                                        <GradientStop Color="#00101216" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Phone24" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"
                                                       Foreground="{DynamicResource DofusAccentBrush}" />
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding ActiveMirror.AccentHex, Converter={StaticResource HexToBrush}}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Visibility="{Binding ActiveMirror.IsConnected, Converter={StaticResource BoolToVis}}" />
                                        <TextBox Text="{Binding ActiveMirror.DeviceName, Mode=OneWay}"
                                                 FontSize="12" Padding="0" MinWidth="40"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 ToolTip="Renommer — Entrée pour valider, Échap pour annuler"
                                                 KeyDown="OnMirrorNameKeyDown"
                                                 LostFocus="OnMirrorNameLostFocus" />
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding ActiveMirror.IsRecording, Converter={StaticResource BoolToVis}}" />
                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="4"
                                                Background="{DynamicResource AppBorderStrongBrush}"
                                                Visibility="{Binding HasInactiveMirrors, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="Ctrl" /><Run Text="+" /><Run Text="{Binding ActiveMirror.Slot, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                               Width="26" Height="22" Padding="0"
                                               Command="{Binding RemoveMirrorCommand}"
                                               CommandParameter="{Binding ActiveMirror}"
                                               ToolTip="Déconnecter cet appareil">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                    </ui:Button>
                                </Grid>
                            </Border>

                            <!-- État déconnecté du miroir actif (Android uniquement — iOS a sa propre attente) -->
                            <Border Background="#E6101216">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveMirror.IsConnected}" Value="False" />
                                                    <Condition Binding="{Binding ActiveMirror.IsIos}" Value="False" />
                                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="32"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveMirror.DeviceName, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,14,0,4" />
                                    <TextBlock Text="Appareil déconnecté — rebranche-le ou reconnecte-le depuis la liste"
                                               FontSize="11.5" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Miniatures des autres appareils + tuiles absentes de l'espace -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasStripContent, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                        <ItemsControl ItemsSource="{Binding InactiveMirrors}" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="172" Height="112" Margin="6,4"
                                            CornerRadius="4" Background="Black"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" ClipToBounds="True"
                                            ToolTip="Cliquer pour rendre actif">
                                        <Grid>
                                            <ContentPresenter Content="{Binding View}" />
                                            <Border VerticalAlignment="Top" Padding="7,3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#D0101216" Offset="0" />
                                                        <GradientStop Color="#00101216" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                                        <TextBox Text="{Binding DeviceName, Mode=OneWay}"
                                                                 FontSize="11" Padding="0" MinWidth="30"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                 ToolTip="Renommer — Entrée pour valider, Échap pour annuler"
                                                                 KeyDown="OnMirrorNameKeyDown"
                                                                 LostFocus="OnMirrorNameLostFocus" />
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" Margin="7,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                                               Width="20" Height="16" Padding="0"
                                                               Command="{Binding DataContext.RemoveMirrorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Déconnecter cet appareil">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    Margin="6" CornerRadius="4"
                                                    Background="#C0101216">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Appearance="Transparent" Width="20" Height="16" Padding="0"
                                                               Command="{Binding DataContext.MoveMirrorLeftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Monter dans la liste">
                                                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="9" />
                                                    </ui:Button>
                                                    <ui:Button Appearance="Transparent" Width="20" Height="16" Padding="0"
                                                               Command="{Binding DataContext.MoveMirrorRightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Descendre dans la liste">
                                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="9" />
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                    Margin="6" Padding="7,2" CornerRadius="4"
                                                    Background="#C0101216">
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Ctrl" /><Run Text="+" /><Run Text="{Binding Slot, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MissingDevices}" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="172" Height="112" Margin="6,4" CornerRadius="4"
                                            Background="{DynamicResource SurfaceFaintBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" Opacity="0.75"
                                            MouseLeftButtonUp="OnMissingClick"
                                            ToolTip="Appareil absent de l'espace — cliquer pour retenter la connexion">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Phone24" FontSize="20"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                            HorizontalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                             Margin="0,0,6,0"
                                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="absent" FontSize="9.5" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Appearance="Transparent" Width="22" Height="18"
                                                       Padding="0" Margin="4"
                                                       Command="{Binding DataContext.RemoveMissingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Retirer de l'espace">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="FullscreenBar"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="4" CornerRadius="4"
                            Background="{DynamicResource AppModalBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding SendBackCommand}" ToolTip="Retour" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14.5" />
                            </ui:Button>
                            <ui:Button Command="{Binding SendHomeCommand}" ToolTip="Accueil" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="Home24" FontSize="14.5" />
                            </ui:Button>
                            <ui:Button Command="{Binding SendRecentsCommand}" ToolTip="Récents" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="SquareMultiple24" FontSize="14.5" />
                            </ui:Button>
                            <ui:Button Click="OnFullscreenClick" ToolTip="Quitter le plein écran (Échap ou F11)" Margin="2" Appearance="Secondary">
                                <ui:SymbolIcon Symbol="FullScreenMinimize24" FontSize="16" />
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- ══ Hub appareils (déconnecté) ══ -->
                    <Grid x:Name="DisconnectedOverlay" Background="{DynamicResource AppModalBrush}"
                          Visibility="{Binding Mirrors.Count, Converter={StaticResource EmptyToVis}}">
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.4" />
                                        <DoubleAnimation Storyboard.TargetName="HubBlock"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="14" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Image Source="assets/mascot.png" Width="620" Opacity="0.035"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HubBlock" MaxWidth="720" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="20,14">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0" />
                            </StackPanel.RenderTransform>

                            <Border Margin="2,0,2,12" Padding="14,11" CornerRadius="4"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding HasActiveWorkspace, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Layer24" FontSize="13" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource DofusAccentBrush}" />
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DofusAccentBrush}">
                                            <Run Text="Espace «" /><Run Text="{Binding ActiveWorkspace.Name, Mode=OneWay}" /><Run Text="» actif" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="Les appareils que tu connectes rejoignent cet espace automatiquement."
                                               FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="2,0,2,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Appareils" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <Run Text="{Binding DetectedDeviceCount, Mode=OneWay}" /><Run Text=" détecté(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding AdbStatus}" FontSize="12" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>

                            <ui:Card Padding="0" BorderThickness="1"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     Background="{DynamicResource AppSurfaceBrush}">
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,15"
                                                    BorderThickness="0,1,0,0"
                                                    BorderBrush="{DynamicResource AppBorderSubtleBrush}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Couleur de l'appareil">
