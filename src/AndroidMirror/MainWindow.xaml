                                   Command="{Binding PairConnectCommand}" IsEnabled="{Binding PairIdle}">
                            <TextBlock Text="{loc:Loc pair.connect}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DofusAccentBrush}" />
