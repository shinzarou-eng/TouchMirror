                    <Grid Margin="0,2,0,10">
                        <Border Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource AppBorderSubtleBrush}" />
                        <TextBlock Text="{loc:Loc pair.or_code}" FontSize="{StaticResource FsCaption}" Padding="9,0"
                                   HorizontalAlignment="Center" Background="{DynamicResource AppModalBrush}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
