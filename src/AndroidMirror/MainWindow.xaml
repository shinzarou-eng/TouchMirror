                                   Visibility="{Binding BenchHasResult, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc bench.relancer}" />
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="ConfirmOverlay" Grid.RowSpan="5" Panel.ZIndex="50"
                Background="{DynamicResource AppModalSolidBrush}"
                Visibility="Collapsed" Opacity="0">
            <Border Width="380" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource AppModalBrush}"
                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="{StaticResource FsSection}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ConfirmBody" Margin="0,9,0,22" TextWrapping="Wrap"
                               FontSize="{StaticResource FsBody}" LineHeight="19"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="ConfirmCancel" Click="OnConfirmDismiss"
                                   Style="{StaticResource BtnAction}"
                                   Margin="0,0,8,0" Padding="16,0" Height="32"
                                   Content="{loc:Loc annuler}" FontSize="{StaticResource FsMeta}" />
                        <ui:Button x:Name="ConfirmOk" Style="{StaticResource BtnPrimary}" Click="OnConfirmOk"
                                   Padding="16,0" Height="32" FontSize="{StaticResource FsMeta}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</ui:FluentWindow>
