                    Background="{DynamicResource AppModalBrush}"
                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{loc:Loc pair.title}" FontSize="{StaticResource FsSection}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
