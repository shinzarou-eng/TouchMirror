                                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                        <Run Text="{Binding SidebarMeta, Mode=OneWay}"
