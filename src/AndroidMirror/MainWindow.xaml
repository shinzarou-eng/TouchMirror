                    <DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <Grid>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{loc:Loc dbg.title}" FontSize="{StaticResource FsSection}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
