            </Grid>
        </Border>

        <Border Grid.RowSpan="5" Panel.ZIndex="50"
                Background="{DynamicResource AppModalSolidBrush}"
                Visibility="{Binding PairOpen, Converter={StaticResource BoolToVis}}">
