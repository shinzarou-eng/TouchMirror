<Application x:Class="TouchMirror.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="FsCaption">10.5</sys:Double>
            <sys:Double x:Key="FsMeta">12</sys:Double>
            <sys:Double x:Key="FsBody">13.5</sys:Double>
            <sys:Double x:Key="FsSection">15</sys:Double>
            <sys:Double x:Key="FsTitle">18</sys:Double>
            <sys:Double x:Key="FsPage">22</sys:Double>
            <sys:Double x:Key="IconSm">12</sys:Double>
            <sys:Double x:Key="IconMd">14</sys:Double>
            <sys:Double x:Key="IconLg">16</sys:Double>
            <sys:Double x:Key="IconXl">20</sys:Double>
            <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
            <CornerRadius x:Key="RadiusControl">7</CornerRadius>
            <CornerRadius x:Key="RadiusPanel">10</CornerRadius>

            <SolidColorBrush x:Key="DofusAccentBrush" Color="#C9D1D9" />
            <SolidColorBrush x:Key="DofusAccentDimBrush" Color="#8B95A1" />
            <SolidColorBrush x:Key="OnDarkTextBrush" Color="#E9EAED" />
            <SolidColorBrush x:Key="OnDarkTextDimBrush" Color="#9AA1AC" />
            <SolidColorBrush x:Key="AppModalSolidBrush" Color="#D8101319" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#E6101216" />

            <Style x:Key="Ic" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style TargetType="ui:ToggleSwitch">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="46,0,0,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:ToggleSwitch">
                            <Grid>
                                <Border x:Name="trackOff" Width="38" Height="20" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" />
                                <Border x:Name="trackOn" Width="38" Height="20" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource AccentButtonBorderBrush}" BorderThickness="1" Opacity="0" />
                                <Ellipse x:Name="knob" Width="14" Height="14"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" Stroke="#33000000" StrokeThickness="1">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="18" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="trackOn"
                                                    Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="trackOn"
                                                    Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="trackOff" Property="Background"
                                            Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="#FFFFFF" Stroke="#29000000" StrokeThickness="1" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource AppModalBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
                <Setter Property="Padding" Value="9,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
                                </Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource AppModalBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource FsMeta}" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Margin" Value="9,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{DynamicResource AppBorderSubtleBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource FsMeta}" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        MinHeight="{TemplateBinding MinHeight}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                        <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L4.5,4.5 L0,9"
                                              Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5" Width="5" Height="9"
                                              VerticalAlignment="Center" Margin="12,0,0,0"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right" HorizontalOffset="-3" VerticalOffset="-5"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource AppModalBrush}"
                                            BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="5" MinWidth="150">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
                                        </Border.Effect>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track Name="PART_Track" IsDirectionReversed="True"
                                       IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumb" CornerRadius="4"
                                                            Background="{DynamicResource ScrollbarThumbBrush}"
                                                            Margin="3,1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource ScrollbarThumbHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
