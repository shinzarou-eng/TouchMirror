<Application x:Class="TouchMirror.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="FsCaption">10.5</sys:Double>
            <sys:Double x:Key="FsMeta">12</sys:Double>
            <sys:Double x:Key="FsBody">13.5</sys:Double>
            <sys:Double x:Key="FsSection">15</sys:Double>
            <sys:Double x:Key="FsTitle">18</sys:Double>
            <sys:Double x:Key="FsPage">22</sys:Double>
            <CornerRadius x:Key="RadiusBadge">3</CornerRadius>
            <CornerRadius x:Key="RadiusControl">6</CornerRadius>
            <CornerRadius x:Key="RadiusPanel">10</CornerRadius>

            <SolidColorBrush x:Key="DofusAccentBrush" Color="#4EC98E" />
            <SolidColorBrush x:Key="DofusAccentDimBrush" Color="#3A9A6F" />
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#4EC98E" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#6FD9AB" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#2F8A62" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#07130D" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#4EC98E" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#66D9A6" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3FAF7E" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#07130D" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#0A2A1D" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4EC98E" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#994EC98E" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#664EC98E" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#66D9A6" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#66D9A6" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4EC98E" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F4EC98E" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#404EC98E" />

            <SolidColorBrush x:Key="AppWindowBrush" Color="#0A0B0F" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111218" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#171923" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#1B1D25" />
            <SolidColorBrush x:Key="AppModalBrush" Color="#F50E1015" />
            <SolidColorBrush x:Key="AppGlassWindowBrush" Color="#D80A0B0F" />
            <SolidColorBrush x:Key="AppGlassSurfaceBrush" Color="#B8111218" />
            <SolidColorBrush x:Key="AppGlassAltBrush" Color="#C8171923" />
            <SolidColorBrush x:Key="AppModalSolidBrush" Color="#FF0E1015" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="SurfaceFaintBrush" Color="#09FFFFFF" />
            <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0D000000" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8E9EC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A7ADB8" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7B818C" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#575C66" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0CFFFFFF" />

            <SolidColorBrush x:Key="WarnBrush" Color="#E0A24C" />
            <SolidColorBrush x:Key="WarnBorderBrush" Color="#40E0A24C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E05B4C" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#26E05B4C" />
            <SolidColorBrush x:Key="GoldBrush" Color="#E8C14A" />
            <SolidColorBrush x:Key="GoldBorderBrush" Color="#40E8C14A" />
            <SolidColorBrush x:Key="InfoBrush" Color="#5B9BD5" />
            <SolidColorBrush x:Key="MutedBrush" Color="#666C77" />

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track Name="PART_Track" IsDirectionReversed="True"
                                       IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumb" CornerRadius="4"
                                                            Background="#2EFFFFFF"
                                                            Margin="3,1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumb" Property="Background" Value="#52FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
