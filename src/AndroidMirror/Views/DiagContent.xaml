<UserControl x:Class="TouchMirror.Views.DiagContent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TouchMirror"
        xmlns:loc="clr-namespace:TouchMirror.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <TextBlock Text="{loc:Loc dbg.sub}" TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}"
                       LineHeight="17" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Border Margin="0,12,0,0" CornerRadius="6" Padding="2"
                    Background="{DynamicResource SurfaceFaintBrush}"
                    BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1">
                <TextBox x:Name="ReportBox" Text="{Binding DebugReport, Mode=OneWay}" IsReadOnly="True" Height="300"
                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" Padding="8,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding DiagIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceFaintBrush}"
                                    BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Fill="{DynamicResource DangerBrush}" />
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsCaption}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Style="{DynamicResource BtnAction}" Height="22" Padding="8,0"
                                                       FontSize="10" CommandParameter="{Binding}"
                                                       Command="{Binding DataContext.DiagIssueFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Visibility="{Binding FixLabel, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock Text="{Binding FixLabel}" />
                                            </ui:Button>
                                            <ui:Button Appearance="Transparent" Padding="6,0" Height="22" Margin="4,0,0,0"
                                                       ToolTip="{loc:Loc dbg.issue_link}" CommandParameter="{Binding}"
                                                       Command="{Binding DataContext.DiagIssueLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcGlobe24}" Width="13" Height="13"
                                                      Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" LineHeight="16"
                                               FontSize="{DynamicResource FsCaption}" Margin="15,5,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <WrapPanel Margin="0,8,0,0">
                <ui:Button Style="{DynamicResource BtnPrimary}" Height="28" Padding="12,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold"
                           Command="{Binding DiagFixAllCommand}"
                           Visibility="{Binding DiagFixAllVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc dbg.fix_all}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagFixAdbCommand}"
                           Visibility="{Binding DiagFixAdbVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc dbg.fix_adb}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagFixReauthCommand}"
                           Visibility="{Binding DiagFixReauthVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc dbg.fix_reauth}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagFixKillCommand}"
                           Visibility="{Binding DiagFixKillVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DiagFixKillLabel}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagFixFwCommand}"
                           Visibility="{Binding DiagFixFwVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc dbg.fix_fw}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagShowGuideCommand}"
                           Visibility="{Binding DiagGuideVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc dbg.guide}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagOpenDevmgmtCommand}"
                           Visibility="{Binding DiagDevmgmtVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc dbg.devmgmt}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding OpenBenchCommand}">
                    <TextBlock Text="{loc:Loc dbg.bench}" />
                </ui:Button>
                <ui:Button Style="{DynamicResource BtnAction}" Height="28" Padding="10,0" Margin="0,0,6,4"
                           FontSize="{DynamicResource FsCaption}" Command="{Binding DiagNetCommand}"
                           IsEnabled="{Binding NetIdle}">
                    <TextBlock Text="{loc:Loc dbg.net}" />
                </ui:Button>
            </WrapPanel>
            <TextBlock Text="{Binding DiagBenchText}" FontFamily="Consolas" FontSize="10" Margin="2,6,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SageBrush}"
                       Visibility="{Binding DiagBenchText, Converter={StaticResource NullToCollapsed}}" />
            <Grid Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="13" Height="13"
                                     Visibility="{Binding DebugBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding DebugNote}" FontSize="{DynamicResource FsCaption}" Margin="8,0,0,0"
                               Foreground="{DynamicResource DofusAccentBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Style="{DynamicResource BtnAction}" Height="30" Padding="10,0" Margin="0,0,6,0"
                               Command="{Binding OpenLogsFolderCommand}" ToolTip="{loc:Loc dbg.logs_tip}">
                        <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcFolderOpen24}" Width="13" Height="13" />
                    </ui:Button>
                    <ui:Button Style="{DynamicResource BtnAction}" Height="30" Padding="10,0" Margin="0,0,6,0"
                               Command="{Binding RefreshDebugCommand}" IsEnabled="{Binding DebugIdle}"
                               ToolTip="{loc:Loc dbg.refresh_tip}">
                        <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcArrowSync24}" Width="13" Height="13" />
                    </ui:Button>
                    <ui:Button Style="{DynamicResource BtnAction}" Height="30" Padding="10,0" Margin="0,0,6,0"
                               Command="{Binding PurgeThumbsCommand}" ToolTip="{loc:Loc dbg.purge_tip}">
                        <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcDismiss24}" Width="13" Height="13" />
                    </ui:Button>
                    <ui:Button Style="{DynamicResource BtnAction}" Height="30" Padding="10,0" Margin="0,0,6,0"
                               Command="{Binding CopyDebugMaskedCommand}" IsEnabled="{Binding DebugIdle}"
                               ToolTip="{loc:Loc dbg.masked_tip}">
                        <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcShieldCheckmark24}" Width="13" Height="13" />
                    </ui:Button>
                    <ui:Button Style="{DynamicResource BtnPrimary}" Height="30" Padding="14,0"
                               FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold"
                               Command="{Binding CopyDebugCommand}" IsEnabled="{Binding DebugIdle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcCopy24}" Width="12" Height="12" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc dbg.copy}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </StackPanel>
        <Border Visibility="{Binding DiagGuideOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource AppWindowBrush}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding DiagGuideTitle}" FontSize="{DynamicResource FsSection}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Button Appearance="Transparent" Padding="7,0" Height="24" HorizontalAlignment="Right"
                               Command="{Binding DiagCloseGuideCommand}">
                        <Path Style="{DynamicResource Ic}" Data="{DynamicResource IcDismiss24}" Width="12" Height="12"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>
                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DiagGuideText}" TextWrapping="Wrap"
                               FontSize="{DynamicResource FsCaption}" LineHeight="18"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
