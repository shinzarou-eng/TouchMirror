<UserControl x:Class="TouchMirror.Views.MirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="True">
    <Grid x:Name="Container" Background="Black">
        <Image x:Name="VideoImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Grid x:Name="InputSurface"
              Background="Transparent"
              Focusable="True"
              MouseDown="OnMouseDown"
              MouseMove="OnMouseMove"
              MouseUp="OnMouseUp"
              MouseWheel="OnMouseWheel"
              LostMouseCapture="OnLostCapture" />

        <!-- Raccourcis plaqués sur la vidéo (touche clavier → tap) -->
        <Canvas x:Name="KeybindLayer" IsHitTestVisible="False" />

        <Border x:Name="KeybindHint"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
                Background="#F214181F" BorderBrush="#3ECF8E" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock FontSize="10.5" Foreground="#9AA6B5" HorizontalAlignment="Center"
                           Text="Clic : placer · touche : assigner · glisser : déplacer · clic droit : supprimer · Échap : quitter" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Style" FontSize="10.5" Foreground="#9AA6B5" VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{Binding KeybindStyle}" Width="92" Height="24"
                              FontSize="11" Margin="6,0,14,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Pastille" />
                        <ComboBoxItem Content="Cercle" />
                        <ComboBoxItem Content="Minimal" />
                    </ComboBox>
                    <TextBlock Text="Opacité" FontSize="10.5" Foreground="#9AA6B5" VerticalAlignment="Center" />
                    <Slider Value="{Binding KeybindOpacity}" Minimum="0.3" Maximum="1"
                            Width="72" Margin="6,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="Taille" FontSize="10.5" Foreground="#9AA6B5" VerticalAlignment="Center" />
                    <Slider Value="{Binding KeybindSize}" Minimum="22" Maximum="44"
                            Width="72" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="IosBadge"
                Padding="10,5"
                CornerRadius="8"
                Background="#B3161616"
                BorderThickness="1"
                BorderBrush="#3A5A8A"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12,40,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Phone24" FontSize="12"
                               Foreground="#8AB4E8" Margin="0,0,7,0" />
                <TextBlock Text="iOS · AFFICHAGE SEUL"
                           Foreground="#8AB4E8"
                           FontSize="10.5"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Grid x:Name="WaitingOverlay"
              Background="#E6101014"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="PhoneScreenTime24" FontSize="40"
                               Foreground="#5A7FA8"
                               HorizontalAlignment="Center" />
                <TextBlock Text="En attente d'un iPhone…"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#DDE6F0"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,6" />
                <TextBlock Text="Centre de contrôle → Recopie de l'écran → « TouchMirror »"
                           FontSize="12.5"
                           Foreground="#9FB2C8"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Même réseau Wi-Fi — affichage seul sans le contrôle Bluetooth"
                           FontSize="11"
                           Foreground="#6E7E92"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock Text="Contrôle tactile : bouton « iPhone » dans la barre d'outils, puis AssistiveTouch → Appareils"
                           FontSize="10.5"
                           Foreground="#5E7A95"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="WaitingHint"
                           FontSize="11.5"
                           Foreground="#D8A04C"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Margin="0,14,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12">
            <Border x:Name="StatsBadge"
                    Padding="10,5"
                    CornerRadius="8"
                    Background="#B3161616"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#4CC94C"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatsText"
                               Foreground="#EAEAEA"
                               FontSize="11.5"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>