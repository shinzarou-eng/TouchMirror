<UserControl x:Class="TouchMirror.Views.GraphWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="SizeAll">
    <Border Padding="9,7" CornerRadius="{StaticResource RadiusControl}"
            Background="{DynamicResource AppModalSolidBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1">
        <StackPanel>
            <DockPanel MinWidth="60">
                <TextBlock x:Name="TitleText" Text="graph" DockPanel.Dock="Left"
                           Foreground="{DynamicResource OnDarkTextDimBrush}" FontSize="{StaticResource FsMeta}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ValueText" Foreground="{DynamicResource OnDarkTextBrush}" FontSize="{StaticResource FsMeta}"
                           FontFamily="Consolas" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </DockPanel>
            <Canvas x:Name="Plot" Width="152" Height="40" Margin="0,5,0,0"
                    Background="#0A0C0E" ClipToBounds="True">
                <Polyline x:Name="Line" Stroke="{DynamicResource DofusAccentBrush}" StrokeThickness="1.5" />
            </Canvas>
            <StackPanel x:Name="LinesPanel" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
