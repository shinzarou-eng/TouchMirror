<UserControl x:Class="TouchMirror.Views.GraphWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="SizeAll">
    <Border Padding="9,7" CornerRadius="8"
            Background="#CC101014" BorderBrush="#3A3F47" BorderThickness="1">
        <StackPanel>
            <DockPanel MinWidth="60">
                <TextBlock x:Name="TitleText" Text="graph" DockPanel.Dock="Left"
                           Foreground="#9AA6B5" FontSize="10.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ValueText" Foreground="#EAEAEA" FontSize="10.5"
                           FontFamily="Consolas" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </DockPanel>
            <Canvas x:Name="Plot" Width="152" Height="40" Margin="0,5,0,0"
                    Background="#0A0C0E" ClipToBounds="True">
                <Polyline x:Name="Line" Stroke="#3ECF8E" StrokeThickness="1.5" />
            </Canvas>
        </StackPanel>
    </Border>
</UserControl>
