<Window x:Class="TouchMirror.Views.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:TouchMirror.Services"
        Title="TouchMirror PiP"
        Topmost="True" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Width="300" Height="196"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize">
    <Border CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            Background="Black" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Image x:Name="Video" Stretch="Uniform" MouseLeftButtonUp="OnVideoClick"
                   Cursor="Hand" ToolTip="{loc:Loc cliquer_pour_rendre_actif}" />
            <Border VerticalAlignment="Top" Padding="7,5"
                    MouseLeftButtonDown="OnHeaderDrag">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E0101216" Offset="0" />
                        <GradientStop Color="#00101216" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Border x:Name="AvatarColor" CornerRadius="5" Background="#3E4750">
                                <TextBlock x:Name="AvatarLetter" FontSize="9" FontWeight="Bold"
                                           Foreground="#0B0E11" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="AvatarImg" CornerRadius="5" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TitleText" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="#EDF1F5"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                               Width="20" Height="16" Padding="0" Click="OnCloseClick"
                               ToolTip="{loc:Loc fermer}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#EDF1F5" StrokeThickness="1.4"
                              Width="8" Height="8" Stretch="Uniform" />
                    </ui:Button>
                </Grid>
            </Border>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Width="18" Height="18" Cursor="SizeNWSE"
                    MouseLeftButtonDown="OnGripDown">
                <Grid>
                    <Path Data="M18,0 L18,18 L0,18 Z" Fill="#60101216"
                          Stretch="Uniform" />
                    <Path Data="M6,18 L18,6 M12,18 L18,12" Stroke="#B0EDF1F5"
                          StrokeThickness="1.2" Stretch="Uniform" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
