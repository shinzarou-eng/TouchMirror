<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>decbench</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <Compile Include="..\src\AndroidMirror\Video\VideoDecoder.cs" Link="VideoDecoder.cs" />
    <Compile Include="..\src\AndroidMirror\Video\IFrameSource.cs" Link="IFrameSource.cs" />
    <Compile Include="..\src\AndroidMirror\Video\Mp4Recorder.cs" Link="Mp4Recorder.cs" />
    <Compile Include="..\src\AndroidMirror\Video\GpuPresenter.cs" Link="GpuPresenter.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\src\AndroidMirror\bin\Release\net10.0-windows10.0.19041.0\assets\ffmpeg\*.dll" Link="assets\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
